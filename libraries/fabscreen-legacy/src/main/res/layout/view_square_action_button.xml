<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/view_square_action_button"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_centerHorizontal="true">

    <Button
        android:id="@+id/btn_view_square_action_button_background"
        android:layout_width="@dimen/size_button_70"
        android:layout_height="@dimen/height_button_70"
        android:layout_centerHorizontal="true"
        android:background="@drawable/all_button_square_default" />

    <Button
        android:id="@+id/btn_view_square_action_button_foreground"
        android:layout_width="65dp"
        android:layout_height="65dp"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="18dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="18dp"
        android:background="@color/transparent"
        android:elevation="10dp"
        android:textColor="@color/default_theme_desc1"
        android:textSize="@dimen/font_size_h2" />

    <TextView
        android:id="@+id/tv_view_square_action_button_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/btn_view_square_action_button_background"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/margin_layout_5"
        android:layout_marginBottom="@dimen/margin_layout_5"
        android:textAlignment="center"
        android:textAllCaps="false"
        android:textColor="@color/custom_grey_200"
        android:textSize="@dimen/font_size_h5"
        android:visibility="gone" />

</RelativeLayout>
