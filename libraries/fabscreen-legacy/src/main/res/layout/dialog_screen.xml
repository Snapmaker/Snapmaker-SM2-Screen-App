<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="@dimen/radius_8">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/default_theme_primary">

        <!-- description -->
        <RelativeLayout
            android:id="@+id/view_dialog_confirm_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_layout_10"
            android:layout_marginTop="@dimen/margin_layout_20"
            android:layout_marginEnd="@dimen/margin_layout_10"
            android:layout_marginBottom="@dimen/margin_layout_20"
            android:minHeight="100dp">

            <ImageView
                android:id="@+id/iv_dialog_confirm_icon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginBottom="@dimen/margin_layout_20"
                android:layout_centerHorizontal="true"
                android:scaleType="fitCenter"
                android:layout_marginTop="@dimen/margin_layout_10"
                android:contentDescription="@string/placeholder" />

            <TextView
                android:id="@+id/tv_dialog_confirm_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/iv_dialog_confirm_icon"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="@dimen/margin_layout_10"
                android:text="@string/all_warning"
                android:textAlignment="center"
                android:textColor="@color/default_theme_title"
                android:textSize="@dimen/font_size_h3"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_dialog_confirm_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_dialog_confirm_title"
                android:layout_marginTop="@dimen/margin_layout_5"
                android:layout_centerVertical="true"
                android:text="@string/placeholder"
                android:textAlignment="center"
                android:textColor="@color/default_theme_title"
                android:textSize="@dimen/font_size_h4" />

        </RelativeLayout>

        <!-- separator -->
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/separator"
            android:layout_alignTop="@id/view_dialog_confirm_buttons"
            android:layout_marginStart="@dimen/margin_layout_5"
            android:layout_marginEnd="@dimen/margin_layout_5"
            android:background="@color/default_theme_separator" />

        <!-- buttons -->
        <LinearLayout
            android:id="@+id/view_dialog_confirm_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/view_dialog_confirm_desc"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_dialog_confirm_cancel"
                style="@style/AppTheme.Button.SquareGrey"
                android:layout_width="0dp"
                android:layout_height="@dimen/height_button_45"
                android:layout_marginStart="@dimen/margin_layout_5"
                android:layout_marginTop="@dimen/margin_layout_5"
                android:layout_marginBottom="@dimen/margin_layout_5"
                android:layout_weight="1"
                android:visibility="gone"
                android:text="@string/placeholder" />

            <Button
                android:id="@+id/btn_dialog_confirm_confirm"
                style="@style/AppTheme.Button.SquareBlue"
                android:layout_width="0dp"
                android:layout_height="@dimen/height_button_45"
                android:layout_marginStart="@dimen/margin_layout_5"
                android:layout_marginTop="@dimen/margin_layout_5"
                android:layout_marginEnd="@dimen/margin_layout_5"
                android:layout_marginBottom="@dimen/margin_layout_5"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:text="@string/placeholder" />

        </LinearLayout>

    </RelativeLayout>

</androidx.cardview.widget.CardView>
