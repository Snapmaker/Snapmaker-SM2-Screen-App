<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:endColor="@color/gradient_blue_end"
                android:startColor="@color/gradient_blue_start" />
            <corners android:radius="@dimen/radius_button_70" />
            <padding
                android:bottom="1dp"
                android:left="1dp"
                android:right="1dp"
                android:top="1dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/default_theme_background" />
            <corners android:radius="@dimen/radius_button_70" />
        </shape>
    </item>
</layer-list>
