<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_theme_background"
    android:clickable="true"
    android:focusable="true">

    <include layout="@layout/widget_top_bar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/margin_layout_5"
        android:background="@color/default_theme_primary"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/iv_calibration_dual_extruder_print_check_load"
                android:layout_width="240dp"
                android:layout_height="80dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="@dimen/margin_layout_40"
                android:contentDescription="@string/todo"
                android:src="@drawable/pic_laser_mode_auto_240x80" />

            <TextView
                android:id="@+id/tv_calibration_dual_extruder_print_check_load_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/iv_calibration_dual_extruder_print_check_load"
                android:layout_marginStart="@dimen/margin_layout_20"
                android:layout_marginEnd="@dimen/margin_layout_20"
                android:layout_marginTop="@dimen/margin_layout_16"
                android:text="@string/calibration_dual_extruder_print_check_load_fragment_or_not_load_desc"
                android:textAlignment="center"
                android:textColor="@color/default_theme_desc1"
                android:textSize="@dimen/font_size_h5" />

            <Button
                android:id="@+id/btn_calibration_dual_extruder_print_check_load"
                style="@style/AppTheme.Button.DefaultButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_button_45"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="@dimen/margin_layout_40"
                android:layout_marginEnd="@dimen/margin_layout_40"
                android:layout_marginBottom="@dimen/margin_layout_20"
                android:text="@string/calibration_dual_extruder_print_check_load_fragment_or_not_load" />

        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/margin_layout_5"
            android:background="@color/default_theme_background" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/iv_calibration_dual_extruder_print_check_print"
                android:layout_width="240dp"
                android:layout_height="80dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="@dimen/margin_layout_40"
                android:contentDescription="@string/todo"
                android:src="@drawable/pic_laser_mode_manual_240x80" />

            <TextView
                android:id="@+id/tv_calibration_dual_extruder_print_check_print_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/iv_calibration_dual_extruder_print_check_print"
                android:layout_marginStart="@dimen/margin_layout_20"
                android:layout_marginEnd="@dimen/margin_layout_20"
                android:layout_marginTop="@dimen/margin_layout_16"
                android:text="@string/calibration_dual_extruder_print_check_load_fragment_or_not_print_desc"
                android:textAlignment="center"
                android:textColor="@color/default_theme_desc1"
                android:textSize="@dimen/font_size_h5" />

            <Button
                android:id="@+id/btn_calibration_dual_extruder_print_check_print"
                style="@style/AppTheme.Button.BlueButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_button_45"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="@dimen/margin_layout_40"
                android:layout_marginEnd="@dimen/margin_layout_40"
                android:layout_marginBottom="@dimen/margin_layout_20"
                android:text="@string/calibration_dual_extruder_print_check_load_fragment_or_not_start_print" />

        </RelativeLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
