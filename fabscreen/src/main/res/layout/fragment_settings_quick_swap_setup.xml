<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_theme_background"
    android:clickable="true"
    android:focusable="true">

    <include layout="@layout/widget_top_bar_back_only" />

    <TextView
        android:id="@+id/tv_settings_quick_swap_setup_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_20"
        android:layout_marginTop="@dimen/margin_layout_20"
        android:layout_marginEnd="@dimen/margin_layout_20"
        android:text="@string/settings_quick_swap_setup_title"
        android:textSize="@dimen/font_size_h3"
        android:textColor="@color/default_theme_title"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <RelativeLayout
        android:id="@+id/ll_settings_quick_swap_select"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_layout_20"
        android:layout_marginStart="@dimen/margin_layout_20"
        android:layout_marginEnd="@dimen/margin_layout_20"
        app:layout_constraintTop_toBottomOf="@id/tv_settings_quick_swap_setup_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RadioGroup
            android:id="@+id/rg_settings_quick_swap_select"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rb_settings_quick_swap_installed"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="end"
                android:button="@null"
                android:background="@drawable/settings_quick_swap_setup_installed" />

            <RadioButton
                android:id="@+id/rb_settings_quick_swap_not_installed"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_marginStart="@dimen/margin_layout_20"
                android:layout_gravity="end"
                android:button="@null"
                android:background="@drawable/settings_quick_swap_setup_not_installed" />

        </RadioGroup>

        <TextView
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_below="@id/rg_settings_quick_swap_select"
            android:layout_marginTop="@dimen/margin_layout_10"
            android:text="@string/settings_quick_swap_setup_screws"
            android:textAlignment="center"
            android:textColor="@color/custom_grey_0"
            android:textSize="@dimen/font_size_h5" />

        <TextView
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:layout_below="@id/rg_settings_quick_swap_select"
            android:layout_alignParentStart="true"
            android:layout_marginTop="@dimen/margin_layout_10"
            android:text="@string/settings_quick_swap_setup_quick_swap_kit"
            android:textAlignment="center"
            android:textColor="@color/custom_grey_0"
            android:textSize="@dimen/font_size_h5" />



    </RelativeLayout>

    <TextView
        android:id="@+id/tv_settings_quick_swap_setup_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_20"
        android:layout_marginTop="@dimen/margin_layout_40"
        android:layout_marginEnd="@dimen/margin_layout_20"
        android:text="@string/settings_quick_swap_setup_desc"
        android:textSize="@dimen/font_size_h5"
        android:textColor="@color/default_theme_title"
        app:layout_constraintTop_toBottomOf="@id/ll_settings_quick_swap_select"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <RelativeLayout
        android:id="@+id/rl_settings_quick_swap_dont_ask_again"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_20"
        android:layout_marginEnd="@dimen/margin_layout_20"
        android:layout_marginTop="@dimen/margin_layout_20"
        android:layout_marginBottom="@dimen/margin_layout_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btn_settings_quick_swap_next_step">

        <CheckBox
            android:id="@+id/cb_settings_quick_swap_dont_ask_again"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_layout_5"
            android:theme="@style/AppTheme.CheckBox.DefaultCheckBox" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/cb_settings_quick_swap_dont_ask_again"
            android:text="@string/settings_quick_swap_setup_dont_ask_again_check_desc"
            android:textAlignment="textStart"
            android:textColor="@color/custom_grey_0"
            android:textSize="@dimen/font_size_h5" />

    </RelativeLayout>

    <Button
        android:id="@+id/btn_settings_quick_swap_next_step"
        style="@style/AppTheme.Button.BlueButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_button_45"
        android:layout_marginStart="@dimen/margin_layout_20"
        android:layout_marginEnd="@dimen/margin_layout_20"
        android:layout_marginBottom="@dimen/margin_layout_20"
        android:text="@string/all_next"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
