<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_theme_background"
    android:clickable="true"
    android:focusable="true">

    <include layout="@layout/widget_top_bar_back_only" />

    <ImageView
        android:id="@+id/iv_quick_swap_parking_position"
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:layout_marginTop="@dimen/margin_layout_40"
        android:contentDescription="@string/all_quick_swap_kit"
        android:src="@drawable/pic_quick_swap_parking_position_112x112"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar" />

    <TextView
        android:id="@+id/tv_quick_swap_park_position_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_40"
        android:layout_marginTop="@dimen/margin_layout_40"
        android:layout_marginEnd="@dimen/margin_layout_40"
        android:text="@string/settings_quick_swap_park_for_easy_swap_title"
        android:textAlignment="center"
        android:textColor="@color/default_theme_title"
        android:textSize="@dimen/font_size_h3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_quick_swap_parking_position" />

    <TextView
        android:id="@+id/tv_quick_swap_park_position_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_40"
        android:layout_marginTop="@dimen/margin_layout_20"
        android:layout_marginEnd="@dimen/margin_layout_40"
        android:text="@string/settings_quick_swap_park_for_easy_swap_desc"
        android:textAlignment="center"
        android:textColor="@color/default_theme_desc1"
        android:lineSpacingMultiplier="1.2"
        android:textSize="@dimen/font_size_h5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_quick_swap_park_position_title" />

    <Button
        android:id="@+id/btn_quick_swap_park_position_start"
        style="@style/AppTheme.Button.BlueButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_button_45"
        android:layout_marginStart="@dimen/margin_layout_40"
        android:layout_marginEnd="@dimen/margin_layout_40"
        android:layout_marginBottom="120dp"
        android:text="@string/settings_quick_swap_park"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
