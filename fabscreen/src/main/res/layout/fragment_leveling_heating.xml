<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include
        layout="@layout/widget_top_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/v_mid_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:background="@color/default_theme_primary"
        app:layout_constraintBottom_toTopOf="@id/v_bottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_bar" />

    <TextView
        android:id="@+id/tv_temp_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:text="@string/print_heated_bed_temp"
        app:layout_constraintEnd_toEndOf="@id/v_mid_container"
        app:layout_constraintStart_toStartOf="@id/v_mid_container"
        app:layout_constraintTop_toTopOf="@id/v_mid_container" />

    <TextView
        android:id="@+id/tv_bed_temp_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:textSize="50sp"
        app:layout_constraintEnd_toStartOf="@id/tv_temp_unit"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@id/v_mid_container"
        app:layout_constraintTop_toBottomOf="@id/tv_temp_title"
        tools:text="50/60" />

    <TextView
        android:id="@+id/tv_temp_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/all_unit_temperature"
        android:textSize="30sp"
        app:layout_constraintBaseline_toBaselineOf="@id/tv_bed_temp_value"
        app:layout_constraintEnd_toEndOf="@id/v_mid_container"
        app:layout_constraintStart_toEndOf="@id/tv_bed_temp_value" />

    <fabscreen.libraries.legacy.view.RulerView
        android:id="@+id/rv_temp"
        style="@style/AppTheme.RulerView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="56dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="56dp"
        app:layout_constraintEnd_toEndOf="@id/v_mid_container"
        app:layout_constraintStart_toStartOf="@id/v_mid_container"
        app:layout_constraintTop_toBottomOf="@id/tv_bed_temp_value"
        app:rv_currentValue="60"
        app:rv_longScaleWidth="2dp"
        app:rv_maxValue="200"
        app:rv_minValue="0"
        app:rv_shortScaleWidth="2dp"
        app:rv_unit="2" />

    <TextView
        android:id="@+id/tv_heat_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/leveling_heat_bed_caution_msg"
        android:textColor="#F5853D"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="@id/v_mid_container"
        app:layout_constraintStart_toStartOf="@id/v_mid_container"
        app:layout_constraintTop_toBottomOf="@id/rv_temp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="@string/leveling_heat_bed_temp_tips"
        android:textColor="#E9E9E9"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="@id/tv_heat_tips"
        app:layout_constraintStart_toStartOf="@id/tv_heat_tips"
        app:layout_constraintTop_toBottomOf="@id/tv_heat_tips" />

    <View
        android:id="@+id/v_bottom"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:background="@color/default_theme_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btn_calibrate"
        style="@style/AppTheme.Button.BlueButton"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:enabled="false"
        android:text="@string/all_heating"
        app:layout_constraintBottom_toBottomOf="@id/v_bottom"
        app:layout_constraintEnd_toEndOf="@id/v_bottom"
        app:layout_constraintStart_toStartOf="@id/v_bottom"
        app:layout_constraintTop_toTopOf="@id/v_bottom" />
</androidx.constraintlayout.widget.ConstraintLayout>
