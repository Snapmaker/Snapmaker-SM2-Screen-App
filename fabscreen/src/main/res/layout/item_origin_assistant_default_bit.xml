<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" >

    <fabscreen.libraries.legacy.view.SquareActionButton
        android:id="@+id/sab_origin_assistant_default_bit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true" />

    <TextView
        android:id="@+id/tv_origin_assistant_default_bit_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/sab_origin_assistant_default_bit"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/margin_layout_5"
        android:layout_marginBottom="@dimen/margin_layout_10"
        android:lines="1"
        android:textAlignment="center"
        android:textAllCaps="false"
        android:textColor="@color/custom_grey_500"
        android:textSize="@dimen/font_size_h6" />

    <!-- Delete button was not implement -->
    <ImageView
        android:id="@+id/iv_origin_assistant_default_bit_del"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:layout_alignTop="@id/sab_origin_assistant_default_bit"
        android:layout_alignEnd="@id/sab_origin_assistant_default_bit"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/pic_dialog_failed_72x72"
        android:visibility="gone" />

</RelativeLayout>
