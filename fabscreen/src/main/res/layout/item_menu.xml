<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="40dp">

    <Button
        android:id="@+id/btn_menu_item"
        style="@style/AppTheme.Button"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageView
        android:id="@+id/iv_menu_item_selected"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_alignStart="@id/btn_menu_item"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/margin_layout_5"
        android:contentDescription="@string/placeholder"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_file_menu_selected_40x40"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/tv_menu_item_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/margin_layout_5"
        android:layout_marginEnd="@dimen/margin_layout_5"
        android:layout_toEndOf="@id/iv_menu_item_selected"
        android:lineSpacingMultiplier="1.2"
        android:singleLine="false"
        android:textAlignment="textStart"
        android:textColor="@color/custom_grey_200"
        android:textSize="@dimen/font_size_h5" />

</RelativeLayout>
