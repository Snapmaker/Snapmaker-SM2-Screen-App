<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_theme_background"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <include layout="@layout/widget_top_bar" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:src="@drawable/pic_10w_maesure_material_thickness_360x240"
        tools:ignore="ContentDescription" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/margin_layout_20"
        android:layout_marginTop="@dimen/margin_layout_32"
        android:layout_marginEnd="@dimen/margin_layout_20"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:text="@string/settings_laser_thickness_measure_calibration_page_desc"
        android:textColor="@color/grey_200"
        android:textSize="@dimen/font_size_h5" />

    <Button
        android:id="@+id/btn_laser_10w_thickness_measure_calibration_start"
        style="@style/AppTheme.Button.BlueButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_button_45"
        android:layout_marginStart="@dimen/margin_layout_40"
        android:layout_marginEnd="@dimen/margin_layout_40"
        android:layout_marginBottom="@dimen/margin_layout_20"
        android:text="@string/all_start" />
</LinearLayout>