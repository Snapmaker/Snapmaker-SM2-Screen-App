<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:layout="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_theme_primary"
    android:focusable="false">

    <include layout="@layout/widget_top_bar" />

    <fabscreen.libraries.legacy.view.SlidingRulerView
        android:id="@+id/srv_experiment"
        android:layout_width="320dp"
        android:layout_height="134dp"
        android:paddingStart="25dp"
        android:paddingEnd="25dp"
        android:layout_marginTop="@dimen/margin_layout_20"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:visibility="visible"
        layout:layout_constraintTop_toBottomOf="@id/top_bar"
        layout:layout_constraintStart_toStartOf="parent"
        layout:layout_constraintEnd_toEndOf="parent"/>

    <fabscreen.libraries.legacy.view.CircularProgressView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="15dp"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="15dp"
        android:layout_marginBottom="15dp"
        android:visibility="gone"
        layout:layout_constraintDimensionRatio="1:1"
        layout:layout_constraintEnd_toEndOf="parent"
        layout:layout_constraintStart_toStartOf="parent"
        layout:layout_constraintTop_toBottomOf="@id/top_bar" />

    <fabscreen.libraries.legacy.view.RulerView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:background="@color/white"
        android:visibility="gone"
        layout:layout_constraintBottom_toBottomOf="parent"
        layout:layout_constraintEnd_toEndOf="parent"
        layout:layout_constraintStart_toStartOf="parent"
        layout:layout_constraintTop_toBottomOf="@id/top_bar" />

    <fabscreen.libraries.legacy.view.BubbleLayout
        android:id="@+id/bl_welcome_set_name_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:visibility="gone"
        layout:background_color="@color/custom_grey_200"
        layout:direction="bottom"
        layout:layout_constraintBottom_toTopOf="parent"
        layout:layout_constraintEnd_toEndOf="parent"
        layout:layout_constraintStart_toStartOf="parent"
        layout:layout_constraintTop_toBottomOf="parent"
        layout:offset="-80dp"
        layout:radius="@dimen/radius_8"
        layout:shadow_color="@color/transparent"
        layout:shadow_size="2dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:padding="10dp"
            android:textSize="@dimen/font_size_h6"
            android:textAlignment="textStart"
            android:text="@string/placeholder_long"
            android:textColor="@color/custom_grey_800" />

    </fabscreen.libraries.legacy.view.BubbleLayout>

</androidx.constraintlayout.widget.ConstraintLayout>