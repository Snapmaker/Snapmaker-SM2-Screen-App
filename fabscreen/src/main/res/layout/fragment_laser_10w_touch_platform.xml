<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_theme_background"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <include layout="@layout/widget_top_bar" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:background="@drawable/pic_laser_10w_settings_toolhead_focus_calibration_1_360x240">

        <TextView
            android:id="@+id/tv_toolhead_mask_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentStart="true"
            android:layout_alignParentEnd="true"
            android:layout_marginStart="@dimen/margin_layout_20"
            android:layout_marginTop="@dimen/margin_layout_10"
            android:layout_marginEnd="@dimen/margin_layout_20"
            android:layout_marginBottom="@dimen/margin_layout_16"
            android:gravity="center"
            android:text="@string/settings_laser_10w_camera_touch_platform_desc" />
    </RelativeLayout>

    <com.snapmaker.fabscreen.view.XYZControlPanel
        android:id="@+id/xyz_panel_touch_platform"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/margin_layout_5"
        android:layout_marginBottom="@dimen/margin_layout_5"
        android:layout_weight="1" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_button_70"
        android:background="@color/custom_grey_800">

        <Button
            android:id="@+id/btn_laser_10w_touch_platform_complete"
            style="@style/AppTheme.Button.BlueButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_button_45"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/margin_layout_20"
            android:layout_marginEnd="@dimen/margin_layout_20"
            android:text="@string/all_complete" />

    </FrameLayout>

</LinearLayout>
