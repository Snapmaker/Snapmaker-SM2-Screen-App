<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_theme_background"
    android:clickable="true"
    android:focusable="true">

    <include layout="@layout/widget_top_bar" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_marginTop="@dimen/margin_layout_5"
        android:layout_marginBottom="@dimen/margin_layout_5"
        android:background="@color/default_theme_primary"
        app:layout_constraintBottom_toTopOf="@id/view_calibration_dual_extruder_sensor_control"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <RelativeLayout
            android:id="@+id/rl_calibration_panel_z_offset"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/default_theme_primary">

            <ImageView
                android:id="@+id/iv_calibration_panel_z_offset"
                android:layout_width="240dp"
                android:layout_height="80dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="85dp"
                android:background="@drawable/pic_calibration_adjust_zoffset_240x80"
                android:scaleType="center" />

            <TextView
                android:id="@+id/tv_calibration_panel_z_offset_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/iv_calibration_panel_z_offset"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="@dimen/margin_layout_5"
                android:singleLine="true"
                android:text="@string/calibration_dialog_z_offset_leveling_desc"
                android:textAlignment="center"
                android:textColor="@color/custom_grey_200"
                android:textSize="@dimen/font_size_h5" />

        </RelativeLayout>

    </FrameLayout>

    <RelativeLayout
        android:id="@+id/view_calibration_dual_extruder_sensor_control"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/margin_layout_5"
        android:layout_marginBottom="@dimen/margin_layout_5"
        android:background="@color/default_theme_primary"
        app:layout_constraintBottom_toTopOf="@id/view_calibration_dual_extruder_sensor_buttons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <include
            layout="@layout/widget_calibration_control_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </RelativeLayout>

    <FrameLayout
        android:id="@+id/view_calibration_dual_extruder_sensor_buttons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/default_theme_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/btn_calibration_dual_extruder_fine_tune_save"
            style="@style/AppTheme.Button.BlueButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_button_45"
            android:layout_marginStart="@dimen/margin_layout_20"
            android:layout_marginTop="@dimen/margin_layout_10"
            android:layout_marginEnd="@dimen/margin_layout_20"
            android:layout_marginBottom="@dimen/margin_layout_10"
            android:text="@string/all_save" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>