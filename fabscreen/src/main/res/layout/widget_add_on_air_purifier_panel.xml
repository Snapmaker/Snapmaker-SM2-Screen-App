<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/widget_add_on_air_purifier_panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/ll_air_purifier_power"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_layout_20"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <fabscreen.libraries.legacy.view.ActionButton
            android:id="@+id/btn_air_purifier_power"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:ab_foreground="@drawable/control_btn_air_purifier_power"
            app:ab_title="@string/air_purifier_fan_power" />

        <TextView
            android:id="@+id/tv_air_purifier_error_power_off"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_layout_5"
            android:text="@string/air_purifier_tip_power_off"
            android:textAlignment="center"
            android:textColor="@color/custom_red_700"
            android:textSize="@dimen/font_size_h6"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_air_purifier_warning_print_affect_notice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_layout_5"
            android:textAlignment="center"
            android:textColor="@color/custom_orange_300"
            android:textSize="@dimen/font_size_h6"
            android:visibility="gone" />

    </LinearLayout>

    <RelativeLayout
        android:id="@+id/rl_add_on_air_purifier_options"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_air_purifier_power">

        <TextView
            android:id="@+id/tv_air_purifier_wind_speed_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_layout_20"
            android:layout_marginTop="@dimen/margin_layout_10"
            android:text="@string/air_purifier_fan_speed"
            android:textAlignment="textStart"
            android:textColor="@color/custom_grey_200"
            android:textSize="@dimen/font_size_h5" />

        <co.ceryle.segmentedbutton.SegmentedButtonGroup
            android:id="@+id/sbg_air_purifier_fan_speed_level"
            style="@style/AppTheme.SegmentedButtonGroup"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_segmented_button"
            android:layout_below="@id/tv_air_purifier_wind_speed_title"
            android:layout_marginStart="@dimen/margin_layout_20"
            android:layout_marginTop="@dimen/margin_layout_10"
            android:layout_marginEnd="@dimen/margin_layout_20"
            app:sbg_position="0">

            <Button
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingTop="8dp"
                android:text="@string/all_low"
                android:textAllCaps="false"
                android:textColor="@color/default_theme_desc1" />

            <Button
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingTop="8dp"
                android:text="@string/all_medium"
                android:textAllCaps="false"
                android:textColor="@color/default_theme_desc1" />

            <Button
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingTop="8dp"
                android:text="@string/all_High"
                android:textAllCaps="false"
                android:textColor="@color/default_theme_desc1" />
        </co.ceryle.segmentedbutton.SegmentedButtonGroup>

        <TextView
            android:id="@+id/tv_air_purifier_life_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/sbg_air_purifier_fan_speed_level"
            android:layout_marginStart="@dimen/margin_layout_20"
            android:layout_marginTop="@dimen/margin_layout_10"
            android:text="@string/air_purifier_filter_life"
            android:textAlignment="textStart"
            android:textColor="@color/custom_grey_200"
            android:textSize="@dimen/font_size_h5" />

        <!--  TODO: Need to refactor this  -->
        <fabscreen.libraries.legacy.view.RectEnergyBar.RectEnergyBar
            android:id="@+id/reb_air_purifier_lifetime"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_below="@id/tv_air_purifier_life_title"
            android:layout_marginStart="@dimen/margin_layout_20"
            android:layout_marginTop="@dimen/margin_layout_10"
            android:layout_marginEnd="@dimen/margin_layout_20"/>

        <TextView
            android:id="@+id/tv_air_purifier_tip_filter_life_low"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/reb_air_purifier_lifetime"
            android:layout_alignStart="@id/reb_air_purifier_lifetime"
            android:layout_marginTop="@dimen/margin_layout_5"
            android:text="@string/air_purifier_tip_filter_life_low"
            android:textAlignment="textStart"
            android:textColor="@color/custom_red_700"
            android:textSize="@dimen/font_size_h6"
            android:visibility="gone" />

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
