<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="16dp">

    <TextView
        android:id="@+id/tv_about_module_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/margin_layout_5"
        android:text="@string/placeholder"
        android:textColor="@color/default_theme_desc1" />

    <TextView
        android:id="@+id/tv_about_module_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/margin_layout_5"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/placeholder_long"
        android:textAlignment="textEnd"
        android:layout_alignParentEnd="true"
        android:textColor="@color/default_theme_title" />

</RelativeLayout>
