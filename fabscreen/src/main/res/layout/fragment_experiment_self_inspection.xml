<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_theme_background"
    android:clickable="true"
    android:focusable="true">

    <include layout="@layout/widget_top_bar" />

    <TextView
        android:id="@+id/tv_experiment_self_inspection_protect_temperature_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_10"
        android:layout_marginTop="@dimen/margin_layout_20"
        android:text="保护温度： "
        android:textAlignment="textStart"
        android:textColor="@color/custom_grey_200"
        android:textSize="@dimen/font_size_h4"
        app:layout_constraintStart_toEndOf="@id/tv_experiment_bluetooth_status"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar" />

    <EditText
        android:id="@+id/ed_experiment_self_inspection_protect_temperature"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_10"
        android:layout_marginTop="@dimen/margin_layout_10"
        android:layout_marginEnd="@dimen/margin_layout_10"
        android:inputType="number"
        android:textAlignment="textStart"
        android:textColor="@color/custom_grey_200"
        android:textSize="@dimen/font_size_h4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_experiment_self_inspection_protect_temperature_desc"
        app:layout_constraintTop_toBottomOf="@id/top_bar" />

    <TextView
        android:id="@+id/tv_experiment_self_inspection_recovery_temperature_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_10"
        android:layout_marginTop="@dimen/margin_layout_32"
        android:text="恢复温度： "
        android:textAlignment="textStart"
        android:textColor="@color/custom_grey_200"
        android:textSize="@dimen/font_size_h4"
        app:layout_constraintStart_toEndOf="@id/tv_experiment_bluetooth_status"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_experiment_self_inspection_protect_temperature_desc" />

    <EditText
        android:id="@+id/ed_experiment_self_inspection_recovery_temperature"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_10"
        android:layout_marginTop="@dimen/margin_layout_10"
        android:layout_marginEnd="@dimen/margin_layout_10"
        android:inputType="number"
        android:textAlignment="textStart"
        android:textColor="@color/custom_grey_200"
        android:textSize="@dimen/font_size_h4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_experiment_self_inspection_recovery_temperature_desc"
        app:layout_constraintTop_toBottomOf="@id/ed_experiment_self_inspection_protect_temperature" />

    <TextView
        android:id="@+id/tv_experiment_self_inspection_temperature"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_layout_32"
        android:textAlignment="center"
        android:textColor="@color/custom_grey_200"
        android:textSize="@dimen/font_size_h4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/tv_experiment_bluetooth_status"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_experiment_self_inspection_recovery_temperature_desc" />


    <RelativeLayout
        android:id="@+id/rl_experiment_si_operation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_10"
        android:layout_marginEnd="@dimen/margin_layout_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">


        <Button
            android:id="@+id/btn_experiment_inspection_temperature_setting"
            style="@style/AppTheme.Button.BlueButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_button_45"
            android:layout_marginStart="@dimen/margin_layout_20"
            android:layout_marginTop="@dimen/margin_layout_10"
            android:layout_marginEnd="@dimen/margin_layout_20"
            android:layout_marginBottom="@dimen/margin_layout_20"
            android:text="Setting"
            android:textAllCaps="false" />

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>