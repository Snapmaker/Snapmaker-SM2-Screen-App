<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

<LinearLayout
    android:id="@+id/ll_tool_box"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_centerInParent="true"
    android:background="@color/transparent"
    android:gravity="center"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:background="@drawable/all_button_square_default_selected">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_layout_20"
            android:layout_marginTop="@dimen/margin_layout_20"
            android:gravity="center"
            android:orientation="vertical">

            <Button
                android:id="@+id/btn_cnc_origin_assistant_entry"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/ic_module_origin_assistant_80x80" />

            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_layout_10"
                android:text="@string/cnc_origin_assistant"
                android:textAlignment="center"
                android:maxLines="2"
                android:textColor="@color/custom_grey_200"
                android:textSize="@dimen/font_size_h5" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="@dimen/margin_layout_20"
            android:layout_marginEnd="25dp"
            android:gravity="center"
            android:orientation="vertical">

            <Button
                android:id="@+id/btn_cnc_bit_assistant_entry"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/ic_module_bit_assistant_80x80" />

            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_layout_10"
                android:text="@string/cnc_bit_assistant"
                android:textAlignment="center"
                android:textColor="@color/custom_grey_200"
                android:textSize="@dimen/font_size_h5" />
        </LinearLayout>

    </RelativeLayout>

    <TextView
        android:id="@+id/dialog_tool_box_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_layout_10"
        android:layout_marginBottom="@dimen/margin_layout_10"
        android:text="@string/cnc_tool_box"
        android:textColor="@color/custom_grey_200"
        android:textSize="@dimen/font_size_h3"
        android:textStyle="bold" />

</LinearLayout>

</RelativeLayout>

