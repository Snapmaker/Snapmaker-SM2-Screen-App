<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_theme_background">

    <include layout="@layout/widget_top_bar" />

    <TextView
        android:id="@+id/tv_factory_version"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="@dimen/font_size_h5"
        android:textColor="@color/default_theme_desc1"
        android:layout_marginTop="@dimen/margin_layout_5"
        android:layout_marginEnd="@dimen/margin_layout_5"
        android:layout_marginStart="@dimen/margin_layout_5"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tv_factory_tool_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="@dimen/font_size_h5"
        android:textColor="@color/default_theme_desc1"
        android:layout_marginTop="@dimen/margin_layout_5"
        android:layout_marginEnd="@dimen/margin_layout_5"
        android:layout_marginStart="@dimen/margin_layout_5"
        app:layout_constraintTop_toBottomOf="@id/tv_factory_version"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ListView
        android:id="@+id/lv_factory_tools"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/margin_layout_5"
        android:divider="@drawable/all_list_view_divider"
        android:dividerHeight="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_factory_tool_head"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>