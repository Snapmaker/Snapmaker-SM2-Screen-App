<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_theme_background">

    <include layout="@layout/widget_top_bar" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/margin_layout_5"
        android:layout_marginBottom="@dimen/margin_layout_5"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/view_setting_machine_type_save"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <!-- CardView is the most convenient way to add corners for image.
        https://stackoverflow.com/questions/2459916/how-to-make-an-imageview-with-rounded-corners -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/margin_layout_5"
            android:layout_marginEnd="@dimen/margin_layout_5"
            android:layout_weight="1"
            app:cardCornerRadius="@dimen/radius_8">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/placeholder"
                android:scaleType="centerCrop"
                android:src="@drawable/pic_machine_model_a150_320x160" />

            <Button
                android:id="@+id/btn_settings_machine_model_mini"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/settings_machine_type_btn_background" />

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/margin_layout_5"
            android:layout_marginTop="@dimen/margin_layout_5"
            android:layout_marginEnd="@dimen/margin_layout_5"
            android:layout_weight="1"
            app:cardCornerRadius="@dimen/radius_8">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/placeholder"
                android:scaleType="centerCrop"
                android:src="@drawable/pic_machine_model_a250_320x160" />

            <Button
                android:id="@+id/btn_settings_machine_model_standard"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/settings_machine_type_btn_background" />

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/margin_layout_5"
            android:layout_marginTop="@dimen/margin_layout_5"
            android:layout_marginEnd="@dimen/margin_layout_5"
            android:layout_weight="1"
            app:cardCornerRadius="@dimen/radius_8">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/placeholder"
                android:scaleType="centerCrop"
                android:src="@drawable/pic_machine_model_a350_320x160" />

            <Button
                android:id="@+id/btn_settings_machine_model_plus"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/settings_machine_type_btn_background" />

        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <RelativeLayout
        android:id="@+id/view_setting_machine_type_save"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/default_theme_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/btn_settings_machine_type_save"
            style="@style/AppTheme.Button.BlueButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_button_45"
            android:layout_marginStart="@dimen/margin_layout_20"
            android:layout_marginTop="@dimen/margin_layout_10"
            android:layout_marginEnd="@dimen/margin_layout_20"
            android:layout_marginBottom="@dimen/margin_layout_10"
            android:text="@string/all_save" />

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>