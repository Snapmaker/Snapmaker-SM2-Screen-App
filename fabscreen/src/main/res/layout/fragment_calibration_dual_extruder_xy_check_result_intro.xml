<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_theme_background"
    android:clickable="true"
    android:focusable="true">

    <include layout="@layout/widget_top_bar" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/margin_layout_5"
        android:layout_marginBottom="@dimen/margin_layout_5"
        android:background="@color/default_theme_primary"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/rl_calibration_dual_extruder_xy_check_result_intro_buttons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <TextView
            android:id="@+id/tv_calibration_dual_extruder_xy_check_result_intro_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_marginStart="@dimen/margin_layout_40"
            android:layout_marginTop="@dimen/margin_layout_40"
            android:layout_marginEnd="@dimen/margin_layout_40"
            android:text="@string/guide_3dp_dual_extruder_xy_calibration_check_result_intro_sub_title"
            android:textAlignment="center"
            android:textColor="@color/custom_grey_200"
            android:textSize="@dimen/font_size_h4"
            tools:text="Observe the Calibration Models" />

        <TextView
            android:id="@+id/tv_calibration_dual_extruder_xy_check_result_intro_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_calibration_dual_extruder_xy_check_result_intro_title"
            android:layout_marginStart="@dimen/margin_layout_40"
            android:layout_marginTop="@dimen/margin_layout_20"
            android:layout_marginEnd="@dimen/margin_layout_40"
            android:text="@string/guide_3dp_dual_extruder_xy_calibration_check_result_intro_desc"
            android:textAlignment="center"
            android:textColor="@color/default_theme_desc1"
            android:textSize="@dimen/font_size_h5" />

        <ImageView
            android:layout_width="280dp"
            android:layout_height="225dp"
            android:layout_below="@id/tv_calibration_dual_extruder_xy_check_result_intro_desc"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/margin_layout_40"
            android:src="@drawable/pic_dual_extruder_xy_calibration_print_check_result_intro_280x225" />

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/rl_calibration_dual_extruder_xy_check_result_intro_buttons"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/default_theme_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/btn_calibration_dual_extruder_xy_check_result_intro_next"
            style="@style/AppTheme.Button.BlueButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_button_45"
            android:layout_centerInParent="true"
            android:layout_marginStart="@dimen/margin_layout_20"
            android:layout_marginEnd="@dimen/margin_layout_20"
            android:text="@string/all_next" />

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
