<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_theme_background"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/tv_guide_laser_fine_tune_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="120dp"
        android:text="@string/calibration_auto_leveling"
        android:textAlignment="center"
        android:textColor="@color/default_theme_title"
        android:textSize="@dimen/font_size_h1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_guide_laser_fine_tune_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_40"
        android:layout_marginTop="@dimen/margin_layout_16"
        android:layout_marginEnd="@dimen/margin_layout_40"
        android:lines="3"
        android:text="@string/laser_warning_desc"
        android:textAlignment="center"
        android:textColor="@color/default_theme_title"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_guide_laser_fine_tune_title" />

    <fabscreen.libraries.legacy.view.BubbleLayout
        android:id="@+id/bl_guide_laser_fine_tune_hint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_40"
        android:layout_marginEnd="@dimen/margin_layout_40"
        android:padding="16dp"
        android:visibility="gone"
        app:background_color="@color/default_theme_primary"
        app:direction="bottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_guide_laser_fine_tune_desc"
        app:radius="@dimen/radius_8"
        app:shadow_color="@color/custom_grey_200"
        app:shadow_size="2dp">

        <TextView
            android:id="@+id/tv_guide_laser_fine_tune_hint"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/margin_layout_10"
            android:layout_marginEnd="@dimen/margin_layout_10"
            android:padding="@dimen/padding_5"
            android:textAlignment="center"
            android:textColor="#EE3333" />

    </fabscreen.libraries.legacy.view.BubbleLayout>

    <fabscreen.libraries.legacy.view.RulerView
        android:id="@+id/rv_guide_laser_fine_tune_ruler"
        style="@style/AppTheme.RulerView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_40"
        android:layout_marginTop="@dimen/margin_layout_40"
        android:layout_marginEnd="@dimen/margin_layout_40"
        android:layout_marginBottom="@dimen/margin_layout_40"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bl_guide_laser_fine_tune_hint"
        app:rv_currentValue="10"
        app:rv_maxValue="20"
        app:rv_minValue="0"
        app:rv_unit="1" />

    <Button
        android:id="@+id/btn_guide_laser_fine_tune_stop"
        style="@style/AppTheme.Button.BlueButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_button_45"
        android:layout_marginStart="@dimen/margin_layout_40"
        android:layout_marginTop="@dimen/margin_layout_40"
        android:layout_marginEnd="@dimen/margin_layout_40"
        android:text="@string/all_stop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rv_guide_laser_fine_tune_ruler" />

    <Button
        android:id="@+id/btn_guide_laser_fine_tune_complete"
        style="@style/AppTheme.Button.BlueButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_button_45"
        android:layout_marginStart="@dimen/margin_layout_40"
        android:layout_marginTop="@dimen/margin_layout_40"
        android:layout_marginEnd="@dimen/margin_layout_40"
        android:text="@string/all_complete"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rv_guide_laser_fine_tune_ruler" />

</androidx.constraintlayout.widget.ConstraintLayout>