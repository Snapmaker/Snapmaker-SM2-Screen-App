<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/placeholder"
        android:src="@drawable/pic_loading_background_000_360x640" />

    <RelativeLayout
        android:id="@+id/view_home_wifi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_10"
        android:layout_marginTop="@dimen/margin_layout_5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_home_wifi"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_alignParentStart="true"
            android:src="@drawable/ic_home_wifi_15x15" />

        <TextView
            android:id="@+id/tv_home_wifi_ssid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_layout_10"
            android:layout_toEndOf="@id/iv_home_wifi"
            android:textColor="@color/default_theme_title"
            android:textSize="@dimen/font_size_h6" />

    </RelativeLayout>

    <TextView
        android:id="@+id/tv_home_slogan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_40"
        android:layout_marginTop="80dp"
        android:fontFamily="@string/font_roboto_condensed"
        android:lines="3"
        android:text="@string/home_slogan"
        android:textAlignment="textStart"
        android:textAllCaps="true"
        android:textColor="@color/default_theme_title"
        android:textSize="@dimen/font_size_h2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_home_status_machine_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_40"
        android:layout_marginTop="@dimen/margin_layout_40"
        android:layout_marginEnd="@dimen/margin_layout_40"
        android:text="@string/placeholder"
        android:textColor="@color/default_theme_title"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_home_slogan" />

    <include
        layout="@layout/fragment_home_3dp_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_20"
        android:layout_marginEnd="@dimen/margin_layout_20"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_home_status_machine_name" />

    <include
        layout="@layout/fragment_home_laser_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_20"
        android:layout_marginEnd="@dimen/margin_layout_20"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_home_status_machine_name" />

    <include
        layout="@layout/fragment_home_cnc_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_20"
        android:layout_marginEnd="@dimen/margin_layout_20"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_home_status_machine_name" />

    <include
        layout="@layout/view_home_3dp_dual_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_40"
        android:layout_marginTop="@dimen/margin_layout_10"
        android:layout_marginEnd="@dimen/margin_layout_40"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_home_status_machine_name" />

    <Button
        android:id="@+id/btn_remote_select_last_received_file"
        style="@style/AppTheme.Button.DefaultButton2"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_button_45"
        android:layout_marginStart="@dimen/margin_layout_40"
        android:layout_marginEnd="@dimen/margin_layout_40"
        android:layout_marginBottom="@dimen/margin_layout_20"
        android:ellipsize="middle"
        android:maxLines="1"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/btn_remote_home_disconnect"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btn_remote_home_disconnect"
        style="@style/AppTheme.Button.StopButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_button_45"
        android:layout_marginStart="@dimen/margin_layout_40"
        android:layout_marginEnd="@dimen/margin_layout_40"
        android:layout_marginBottom="80dp"
        android:text="@string/all_disconnect"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>