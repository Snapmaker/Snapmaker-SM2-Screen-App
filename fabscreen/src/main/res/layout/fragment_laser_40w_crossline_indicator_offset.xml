<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_theme_background"
    android:clickable="true"
    android:focusable="true">

    <include layout="@layout/widget_top_bar" />

    <RelativeLayout
        android:id="@+id/view_laser_40w_crossline_indicator_offset"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="100dp"
        android:layout_marginBottom="@dimen/margin_layout_10"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" >

        <TextView
            android:id="@+id/tv_laser_40w_crossline_indicator_x_offset_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="@dimen/margin_layout_40"
            android:layout_marginTop="@dimen/margin_layout_5"
            android:text="@string/settings_advance_laser_40w_crossline_indicator_x_offset"
            android:textAlignment="textStart"
            android:textColor="@color/custom_grey_200"
            android:textSize="@dimen/font_size_h5" />

        <EditText
            android:id="@+id/et_laser_40w_crossline_indicator_x_offset"
            style="@style/AppTheme.EditText.DefaultEditText"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_edit_text_45"
            android:layout_below="@id/tv_laser_40w_crossline_indicator_x_offset_desc"
            android:layout_alignStart="@id/tv_laser_40w_crossline_indicator_x_offset_desc"
            android:layout_marginTop="@dimen/margin_layout_10"
            android:layout_marginEnd="@dimen/margin_layout_40"
            android:hint="@string/all_0_00"
            android:inputType="numberDecimal|numberSigned" />
        
        <TextView
            android:id="@+id/tv_laser_40w_crossline_indicator_x_offset_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/et_laser_40w_crossline_indicator_x_offset"
            android:layout_alignStart="@id/tv_laser_40w_crossline_indicator_x_offset_desc"
            android:layout_marginTop="@dimen/margin_layout_5"
            android:text="@string/placeholder"
            android:textAlignment="textStart"
            android:textColor="@color/default_theme_text_warning"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/tv_laser_40w_crossline_indicator_y_offset_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_laser_40w_crossline_indicator_x_offset_tip"
            android:layout_alignStart="@id/tv_laser_40w_crossline_indicator_x_offset_desc"
            android:layout_marginTop="40dp"
            android:text="@string/settings_advance_laser_40w_crossline_indicator_y_offset"
            android:textAlignment="textStart"
            android:textColor="@color/custom_grey_200"
            android:textSize="@dimen/font_size_h5" />

        <EditText
            android:id="@+id/et_laser_40w_crossline_indicator_y_offset"
            style="@style/AppTheme.EditText.DefaultEditText"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_edit_text_45"
            android:layout_below="@id/tv_laser_40w_crossline_indicator_y_offset_desc"
            android:layout_alignStart="@id/tv_laser_40w_crossline_indicator_x_offset_desc"
            android:hint="@string/all_0_00"
            android:layout_marginTop="@dimen/margin_layout_10"
            android:layout_marginEnd="@dimen/margin_layout_40"
            android:inputType="numberDecimal|numberSigned"/>

        <TextView
            android:id="@+id/tv_laser_40w_crossline_indicator_y_offset_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/et_laser_40w_crossline_indicator_y_offset"
            android:layout_alignStart="@id/tv_laser_40w_crossline_indicator_x_offset_desc"
            android:layout_marginTop="@dimen/margin_layout_5"
            android:text="@string/placeholder"
            android:textAlignment="textStart"
            android:textColor="@color/default_theme_text_warning"
            android:visibility="gone"/>

    </RelativeLayout>
    <!-- buttons -->
    <FrameLayout
        android:id="@+id/view_laser_40w_crossline_indicator_offset_buttons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/default_theme_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/btn_laser_40w_crossline_indicator_offset_next"
            style="@style/AppTheme.Button.BlueButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_button_45"
            android:layout_marginStart="@dimen/margin_layout_20"
            android:layout_marginTop="@dimen/margin_layout_10"
            android:layout_marginEnd="@dimen/margin_layout_20"
            android:layout_marginBottom="@dimen/margin_layout_10"
            android:text="@string/all_next" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
