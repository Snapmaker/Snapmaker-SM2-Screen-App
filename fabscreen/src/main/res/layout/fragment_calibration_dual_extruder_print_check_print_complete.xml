<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_theme_background"
    android:clickable="true"
    android:focusable="true">

    <include layout="@layout/widget_top_bar_back_only" />

    <ImageView
        android:id="@+id/iv_calibration_dual_extruder_print_check_complete"
        android:layout_width="240dp"
        android:layout_height="120dp"
        android:layout_marginTop="@dimen/margin_layout_60"
        android:src="@drawable/pic_dual_extruder_print_check_print_complete_240x120"
        android:scaleType="centerCrop"
        android:contentDescription="@string/placeholder"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="@dimen/margin_layout_20"
        android:layout_marginEnd="@dimen/margin_layout_20"
        android:layout_marginTop="@dimen/margin_layout_50"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_calibration_dual_extruder_print_check_complete">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/calibration_dual_extruder_print_check_print_complete_title"
            android:textAlignment="center"
            android:textColor="@color/custom_grey_200"
            android:textSize="@dimen/font_size_h3"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/calibration_dual_extruder_print_check_print_complete_desc"
            android:textColor="@color/custom_grey_200"
            android:textSize="@dimen/font_size_h4"
            android:textAlignment="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_layout_20"
            android:text="@string/calibration_dual_extruder_print_check_print_complete_tip"
            android:textAlignment="center"
            android:textColor="@color/custom_orange_100"
            android:textSize="@dimen/font_size_h6" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/view_calibration_dual_extruder_print_check_get_started_buttons"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/margin_layout_40"
        android:layout_marginEnd="@dimen/margin_layout_40"
        android:layout_marginBottom="@dimen/margin_layout_32"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/btn_calibration_dual_extruder_print_check_next"
            style="@style/AppTheme.Button.BlueButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_button_45"
            android:text="@string/all_next" />

        <Button
            android:id="@+id/btn_calibration_dual_extruder_print_check_restart_print"
            style="@style/AppTheme.Button.SecondaryButton"
            android:text="@string/calibration_dual_extruder_print_check_print_complete_restart_print"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_button_45"
            android:layout_marginTop="@dimen/margin_layout_10" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
