<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_theme_background">

    <include layout="@layout/widget_top_bar" />

    <RelativeLayout
        android:id="@+id/rl_settings_firmware"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/pic_loading_background_000_360x640"
        app:layout_constraintBottom_toTopOf="@id/fl_settings_firmware_buttons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <!--    change logs    -->
        <LinearLayout
            android:id="@+id/ll_settings_firmware_change_logs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_layout_20"
            android:layout_marginTop="@dimen/margin_layout_20"
            android:layout_marginEnd="@dimen/margin_layout_20"
            android:divider="@color/transparent"
            android:orientation="vertical">

            <!--      version      -->
            <LinearLayout
                android:id="@+id/ll_firmware_version"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@color/transparent"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_firmware_change_log_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@string/font_roboto_condensed_light"
                    android:textAlignment="textStart"
                    android:textColor="@color/custom_grey_200"
                    android:textSize="@dimen/font_size_h2" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_firmware_change_logs_desc"
                    android:textAlignment="textStart"
                    android:textColor="@color/custom_grey_500"
                    android:textSize="@dimen/font_size_h6" />

            </LinearLayout>

            <!--      new feature      -->
            <LinearLayout
                android:id="@+id/ll_firmware_new_features"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_layout_20"
                android:divider="@color/transparent"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_firmware_change_logs_new_feature"
                    android:textAlignment="textStart"
                    android:textColor="@color/custom_grey_200"
                    android:textSize="@dimen/font_size_h5"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_firmware_new_features"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAlignment="textStart"
                    android:textColor="@color/custom_grey_500"
                    android:textSize="@dimen/font_size_h6" />

            </LinearLayout>

            <!--      bug fixed      -->
            <LinearLayout
                android:id="@+id/ll_firmware_bug_fixes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_layout_20"
                android:divider="@color/transparent"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_firmware_change_logs_bug_fixed"
                    android:textAlignment="textStart"
                    android:textColor="@color/custom_grey_200"
                    android:textSize="@dimen/font_size_h5"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_firmware_bug_fixes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAlignment="textStart"
                    android:textColor="@color/custom_grey_500"
                    android:textSize="@dimen/font_size_h6" />

            </LinearLayout>

            <!--      improvements      -->
            <LinearLayout
                android:id="@+id/ll_firmware_improvements"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_layout_20"
                android:divider="@color/transparent"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_firmware_change_logs_improvements"
                    android:textAlignment="textStart"
                    android:textColor="@color/custom_grey_200"
                    android:textSize="@dimen/font_size_h5"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_firmware_improvements"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAlignment="textStart"
                    android:textColor="@color/custom_grey_500"
                    android:textSize="@dimen/font_size_h6" />

            </LinearLayout>

        </LinearLayout>

    </RelativeLayout>

    <TextView
        android:id="@+id/tv_settings_firmware_warning"
        style="@style/AppTheme.TextView.WarningTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_40"
        android:layout_marginEnd="@dimen/margin_layout_40"
        android:layout_marginBottom="@dimen/margin_layout_10"
        android:singleLine="true"
        android:text="@string/settings_firmware_unstable_network_connection"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/fl_settings_firmware_buttons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <FrameLayout
        android:id="@+id/fl_settings_firmware_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_layout_5"
        android:background="@color/default_theme_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/btn_settings_firmware_check_updates"
            style="@style/AppTheme.Button.DefaultButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_button_45"
            android:layout_marginStart="@dimen/margin_layout_20"
            android:layout_marginTop="@dimen/margin_layout_10"
            android:layout_marginEnd="@dimen/margin_layout_20"
            android:layout_marginBottom="@dimen/margin_layout_10"
            android:text="@string/settings_firmware_check_for_update" />

        <Button
            android:id="@+id/btn_settings_firmware_update"
            style="@style/AppTheme.Button.BlueButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_button_45"
            android:layout_marginStart="@dimen/margin_layout_20"
            android:layout_marginTop="@dimen/margin_layout_10"
            android:layout_marginEnd="@dimen/margin_layout_20"
            android:layout_marginBottom="@dimen/margin_layout_10"
            android:text="@string/settings_firmware_update_now"
            android:visibility="gone" />

        <fabscreen.libraries.legacy.view.ProgressButton
            android:id="@+id/btn_settings_firmware_download_update"
            style="@style/AppTheme.DefaultProgressButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_button_45"
            android:layout_marginStart="@dimen/margin_layout_20"
            android:layout_marginTop="@dimen/margin_layout_10"
            android:layout_marginEnd="@dimen/margin_layout_20"
            android:layout_marginBottom="@dimen/margin_layout_10"
            android:text="@string/settings_firmware_download_firmware"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_settings_firmware_factory_reset"
            style="@style/AppTheme.Button.DefaultButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_button_45"
            android:layout_marginStart="@dimen/margin_layout_20"
            android:layout_marginTop="@dimen/margin_layout_10"
            android:layout_marginEnd="@dimen/margin_layout_20"
            android:layout_marginBottom="@dimen/margin_layout_10"
            android:text="@string/settings_firmware_factory_reset"
            android:visibility="gone" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

