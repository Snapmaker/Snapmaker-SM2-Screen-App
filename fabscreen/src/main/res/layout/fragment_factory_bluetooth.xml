<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_theme_background"
    android:clickable="true"
    android:focusable="true">

    <include layout="@layout/widget_top_bar" />

    <TextView
        android:id="@+id/tv_factory_bluetooth_status_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_10"
        android:layout_marginTop="@dimen/margin_layout_20"
        android:text="蓝牙状态:"
        android:textAlignment="textStart"
        android:textColor="@color/custom_grey_200"
        android:textSize="@dimen/font_size_h2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar" />


    <TextView
        android:id="@+id/tv_factory_bluetooth_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_10"
        android:layout_marginTop="@dimen/margin_layout_20"
        android:text="@string/placeholder"
        android:textAlignment="textStart"
        android:textColor="@color/custom_grey_200"
        android:textSize="@dimen/font_size_h2"
        app:layout_constraintStart_toEndOf="@id/tv_factory_bluetooth_status_desc"
        app:layout_constraintTop_toBottomOf="@id/top_bar" />

    <Button
        android:id="@+id/btn_factory_bluetooth_request"
        style="@style/AppTheme.Button.BlueButton"
        android:layout_width="0dp"
        android:layout_height="@dimen/height_button_45"
        android:layout_marginStart="@dimen/margin_layout_20"
        android:layout_marginTop="@dimen/margin_layout_40"
        android:layout_marginEnd="@dimen/margin_layout_20"
        android:layout_marginBottom="@dimen/margin_layout_20"
        android:text="获取照片测试"
        android:textAllCaps="false"
        app:layout_constraintTop_toBottomOf="@id/tv_factory_bluetooth_status_desc"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_factory_bluetooth_camera_lighting"
        />

    <Button
        android:id="@+id/btn_factory_bluetooth_camera_lighting"
        style="@style/AppTheme.Button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_layout_40"
        android:layout_marginEnd="@dimen/margin_layout_10"
        android:background="@drawable/files_file_type_btn_background"
        android:text="补光灯"
        android:textAllCaps="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_factory_bluetooth_status_desc" />


    <TextView
        android:id="@+id/tv_factory_bluetooth_used_time"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_layout_20"
        android:textSize="@dimen/font_size_h2"
        android:textAlignment="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_factory_bluetooth_request"/>

    <TextView
        android:id="@+id/tv_factory_bluetooth_result"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_layout_40"
        android:textSize="@dimen/font_size_h2"
        android:textAlignment="center"
        android:lines="3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_factory_bluetooth_used_time" />

    <ImageView
        android:id="@+id/iv_factory_bluetooth_image"
        android:layout_width="320dp"
        android:layout_height="240dp"
        android:layout_marginTop="@dimen/margin_layout_10"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_factory_bluetooth_result" />

</androidx.constraintlayout.widget.ConstraintLayout>