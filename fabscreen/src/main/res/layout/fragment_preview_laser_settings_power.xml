<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_theme_background"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <include layout="@layout/widget_top_bar" />

    <FrameLayout
        android:id="@+id/view_preview_laser_settings_power_step_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_button_64">

    </FrameLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/default_theme_primary">

        <TextView
            android:id="@+id/tv_preview_laser_settings_power"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_layout_40"
            android:text="@string/print_laser_power"
            android:textAllCaps="true"
            android:textColor="@color/default_theme_desc1"
            android:textSize="@dimen/font_size_h3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/ll_preview_laser_settings_power"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_layout_20"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_preview_laser_settings_power">

            <TextView
                android:id="@+id/tv_preview_laser_settings_power_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/default_theme_title"
                android:textSize="@dimen/font_size_h1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/all_unit_percentage"
                android:textSize="@dimen/font_size_h3" />

        </LinearLayout>

        <fabscreen.libraries.legacy.view.RulerView
            android:id="@+id/rv_preview_laser_settings_power"
            style="@style/AppTheme.RulerView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_layout_40"
            android:layout_marginTop="@dimen/margin_layout_20"
            android:layout_marginEnd="@dimen/margin_layout_40"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ll_preview_laser_settings_power"
            app:rv_currentValue="0"
            app:rv_maxValue="100"
            app:rv_minValue="0" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_button_80"
        android:layout_marginTop="@dimen/margin_layout_5"
        android:background="@color/default_theme_primary">

        <Button
            android:id="@+id/btn_preview_laser_settings_power_next"
            style="@style/AppTheme.Button.BlueButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_button_45"
            android:layout_marginStart="@dimen/margin_layout_40"
            android:layout_marginTop="@dimen/margin_layout_16"
            android:layout_marginEnd="@dimen/margin_layout_40"
            android:text="@string/all_next" />

    </FrameLayout>

</LinearLayout>