<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:layout="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_theme_background"
    android:focusable="false">

    <include
        android:id="@+id/include"
        layout="@layout/widget_top_bar" />

    <TextView
        android:id="@+id/tv_experiment_crashlytics_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_10"
        android:layout_marginTop="@dimen/margin_layout_20"
        android:text="Crash 延时： "
        android:textAlignment="textStart"
        android:textColor="@color/custom_grey_200"
        android:textSize="@dimen/font_size_h4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/include" />

    <EditText
        android:id="@+id/ed_experiment_crashlytics"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_10"
        android:layout_marginTop="@dimen/margin_layout_10"
        android:layout_marginEnd="@dimen/margin_layout_10"
        android:inputType="number"
        android:textAlignment="textStart"
        android:textColor="@color/custom_grey_200"
        android:textSize="@dimen/font_size_h4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_experiment_crashlytics_desc"
        app:layout_constraintTop_toBottomOf="@id/include" />

    <TextView
        android:id="@+id/tv_experiment_crashlytics_show"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_40"
        android:layout_marginTop="@dimen/margin_layout_32"
        android:layout_marginEnd="@dimen/margin_layout_40"
        android:textAlignment="center"
        android:textColor="@color/custom_grey_200"
        android:textSize="@dimen/font_size_h4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ed_experiment_crashlytics" />


    <Button
        android:id="@+id/btn_experiment_crashlytic_test_delay"
        style="@style/AppTheme.Button.BlueButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_button_45"
        android:layout_marginStart="@dimen/margin_layout_40"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="@dimen/margin_layout_40"
        android:text="Delay Start"
        layout:layout_constraintTop_toBottomOf="@+id/tv_experiment_crashlytics_show"
        tools:layout_editor_absoluteX="40dp" />

    <Button
        android:id="@+id/btn_experiment_crashlytic_test"
        style="@style/AppTheme.Button.BlueButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_button_45"
        android:layout_marginStart="@dimen/margin_layout_40"
        android:layout_marginEnd="@dimen/margin_layout_40"
        android:layout_marginBottom="@dimen/margin_layout_40"
        android:text="@string/all_start"
        layout:layout_constraintBottom_toBottomOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>
