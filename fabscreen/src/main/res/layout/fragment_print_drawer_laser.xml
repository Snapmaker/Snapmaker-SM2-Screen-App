<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="360dp"
    android:layout_height="match_parent"
    android:background="@color/default_theme_background"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <include layout="@layout/widget_top_bar" />

    <fabscreen.libraries.legacy.view.NoScrollViewPager
        android:id="@+id/vp_print_drawer_view_pager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/margin_layout_5"
        android:background="@color/default_theme_primary"
        app:layout_constraintBottom_toTopOf="@id/hsv_bottom_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <include layout="@layout/fragment_print_settings_laser_page_power" />

        <include layout="@layout/fragment_print_settings_laser_page_work_speed" />

        <include layout="@layout/fragment_print_settings_add_on_enclosure" />

        <include layout="@layout/fragment_print_settings_add_on_air_purifier" />

    </fabscreen.libraries.legacy.view.NoScrollViewPager>


    <!--  FiXME: Workaround here. Need to fix this with UI design -->
    <HorizontalScrollView
        android:id="@+id/hsv_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_bottom_bar"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" >

        <fabscreen.libraries.legacy.view.bottombar.BottomBar
            android:id="@+id/bb_print_drawer_bottom_bar"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/height_bottom_bar" />

    </HorizontalScrollView>



</androidx.constraintlayout.widget.ConstraintLayout>

