<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/height_button_45">

    <Button
        android:id="@+id/btn_settings_language_name"
        style="@style/AppTheme.Button"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/margin_layout_5"
        android:layout_marginEnd="@dimen/margin_layout_5"
        android:background="@drawable/all_list_item_btn_background"
        android:padding="@dimen/padding_5"
        android:paddingStart="10dp"
        android:paddingEnd="0dp"
        android:textAlignment="textStart"
        android:textAllCaps="false"
        android:textColor="@color/default_theme_title"
        android:textSize="@dimen/font_size_h5" />

    <ImageView
        android:id="@+id/iv_settings_language_selected"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_alignEnd="@id/btn_settings_language_name"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/margin_layout_10"
        android:clickable="false"
        android:contentDescription="@string/placeholder"
        android:src="@drawable/ic_settings_wifi_selected_18x18"
        android:visibility="gone" />

</RelativeLayout>
