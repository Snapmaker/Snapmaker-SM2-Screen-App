<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_theme_background"
    android:clickable="true"
    android:fitsSystemWindows="true"
    android:focusable="true">

    <include layout="@layout/widget_top_bar_back_only" />

    <TextView
        android:id="@+id/tv_welcome_name_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_40"
        android:layout_marginTop="160dp"
        android:layout_marginEnd="@dimen/margin_layout_40"
        android:fontFamily="@string/font_roboto_condensed"
        android:text="@string/welcome_name_title"
        android:textAlignment="center"
        android:textColor="@color/default_theme_title"
        android:textSize="@dimen/font_size_h2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <RelativeLayout
        android:id="@+id/view_welcome_name_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_welcome_name_title">

        <EditText
            android:id="@+id/et_welcome_name_input"
            style="@style/AppTheme.EditText.DefaultEditText"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_edit_text_45"
            android:layout_marginStart="@dimen/margin_layout_40"
            android:layout_marginTop="@dimen/margin_layout_40"
            android:layout_marginEnd="@dimen/margin_layout_40"
            android:hint="@string/welcome_name_placeholder"
            android:inputType="text" />

        <TextView
            android:id="@+id/tv_welcome_name_tip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/et_welcome_name_input"
            android:layout_marginStart="@dimen/margin_layout_10"
            android:layout_marginTop="@dimen/margin_layout_5"
            android:layout_marginEnd="@dimen/margin_layout_10"
            android:text="@string/placeholder"
            android:textAlignment="center"
            android:textColor="@color/default_theme_text_warning" />

    </RelativeLayout>

    <Button
        android:id="@+id/btn_welcome_name_next"
        style="@style/AppTheme.Button.BlueButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_button_45"
        android:layout_marginStart="@dimen/margin_layout_40"
        android:layout_marginTop="@dimen/margin_layout_40"
        android:layout_marginEnd="@dimen/margin_layout_40"
        android:layout_marginBottom="@dimen/margin_layout_40"
        android:text="@string/all_save"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/view_welcome_name_input" />

</androidx.constraintlayout.widget.ConstraintLayout>