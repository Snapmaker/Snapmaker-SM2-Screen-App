<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include layout="@layout/widget_top_bar" />

    <!-- local files -->
    <RelativeLayout
        android:id="@+id/view_browse_local_files"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/margin_layout_5"
        android:layout_marginTop="@dimen/margin_layout_5"
        android:layout_marginEnd="@dimen/margin_layout_5"
        android:layout_marginBottom="@dimen/margin_layout_5"
        app:layout_constraintBottom_toTopOf="@id/view_browse_bottom_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <fabscreen.libraries.legacy.view.SwipeListView
            android:id="@+id/lv_browse_local_files"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@drawable/all_list_view_divider"
            android:dividerHeight="@dimen/height_list_divider" />

        <RelativeLayout
            android:id="@+id/view_browse_local_files_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_browse_local_files_empty"
                android:layout_width="60dp"
                android:layout_height="70dp"
                android:layout_centerHorizontal="true"
                android:contentDescription="@string/placeholder"
                android:src="@drawable/ic_files_empty_60x70" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/iv_browse_local_files_empty"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="@dimen/margin_layout_10"
                android:singleLine="true"
                android:text="@string/browse_file_is_empty"
                android:textAlignment="center"
                android:textColor="@color/custom_grey_600"
                android:textSize="@dimen/font_size_h5"
                android:textStyle="bold" />

        </RelativeLayout>


    </RelativeLayout>

    <!-- usb files -->
    <RelativeLayout
        android:id="@+id/view_browse_remote_files"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/margin_layout_5"
        android:layout_marginTop="@dimen/margin_layout_5"
        android:layout_marginEnd="@dimen/margin_layout_5"
        android:layout_marginBottom="@dimen/margin_layout_5"
        app:layout_constraintBottom_toTopOf="@id/view_browse_bottom_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <fabscreen.libraries.legacy.view.SwipeListView
            android:id="@+id/lv_browse_remote_files"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@drawable/all_list_view_divider"
            android:dividerHeight="@dimen/height_list_divider"
            android:visibility="gone" />

        <!-- Empty remote file  -->
        <RelativeLayout
            android:id="@+id/view_browse_remote_files_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_browse_remote_files_empty"
                android:layout_width="60dp"
                android:layout_height="70dp"
                android:layout_centerHorizontal="true"
                android:contentDescription="@string/placeholder"
                android:src="@drawable/ic_files_empty_60x70" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/iv_browse_remote_files_empty"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="@dimen/margin_layout_10"
                android:singleLine="true"
                android:text="@string/browse_file_is_empty"
                android:textAlignment="center"
                android:textColor="@color/custom_grey_600"
                android:textSize="@dimen/font_size_h5"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Error remote file  -->
        <RelativeLayout
            android:id="@+id/view_browse_usb_file_unable_to_identify"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="vertical"
            android:visibility="gone"
            >

            <ImageView
                android:id="@+id/iv_browse_usb_file_unable_to_identify"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_centerHorizontal="true"
                android:contentDescription="@string/placeholder"
                android:src="@drawable/ic_files_error_80x80" />

            <TextView
                android:id="@+id/tv_browse_usb_file_unable_to_identify"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/iv_browse_usb_file_unable_to_identify"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="@dimen/margin_layout_20"
                android:singleLine="true"
                android:text="@string/browse_usb_file_unable_to_identify"
                android:textAlignment="center"
                android:textColor="@color/custom_grey_600"
                android:textSize="@dimen/font_size_h5"
                android:textStyle="bold"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_browse_usb_file_unable_to_identify"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="@dimen/margin_layout_20"
                android:singleLine="false"
                android:text="@string/browse_usb_file_unable_to_identify_desc"
                android:textAlignment="center"
                android:textColor="@color/custom_grey_600"
                android:textSize="@dimen/font_size_h5"
                />
        </RelativeLayout>

    </RelativeLayout>

    <!-- Bottom Navigation bar and operation bar -->
    <FrameLayout
        android:id="@+id/view_browse_bottom_bar"
        android:layout_width="0dp"
        android:layout_height="58dp"
        app:layout_constraintBottom_toTopOf="@id/view_browse_space_usage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- file type -->
        <fabscreen.libraries.legacy.view.bottombar.BottomBar
            android:id="@+id/bb_browse_file_type"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- multi-selected bar -->
        <LinearLayout
            android:id="@+id/view_browse_multi_selected_bar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/default_theme_primary"
            android:orientation="horizontal"
            android:visibility="gone">

            <!-- Delete -->
            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/margin_layout_5"
                android:layout_marginTop="@dimen/margin_layout_5"
                android:layout_marginEnd="@dimen/margin_layout_2h"
                android:layout_marginBottom="@dimen/margin_layout_5"
                android:layout_weight="1">

                <Button
                    android:id="@+id/btn_browse_multi_delete"
                    style="@style/AppTheme.Button.SquareRed"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <ImageView
                    android:id="@+id/iv_browse_multi_delete"
                    android:layout_width="32dp"
                    android:layout_height="28dp"
                    android:layout_centerInParent="true"
                    android:contentDescription="@string/placeholder"
                    android:src="@drawable/files_iv_multi_delete" />

            </RelativeLayout>

            <!-- Rename -->
            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/margin_layout_2h"
                android:layout_marginTop="@dimen/margin_layout_5"
                android:layout_marginEnd="@dimen/margin_layout_5"
                android:layout_marginBottom="@dimen/margin_layout_5"
                android:layout_weight="1">

                <Button
                    android:id="@+id/btn_browse_multi_rename"
                    style="@style/AppTheme.Button.SquareGrey"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <ImageView
                    android:id="@+id/iv_browse_multi_rename"
                    android:layout_width="32dp"
                    android:layout_height="28dp"
                    android:layout_centerInParent="true"
                    android:contentDescription="@string/placeholder"
                    android:src="@drawable/files_iv_multi_rename" />

            </RelativeLayout>

        </LinearLayout>

    </FrameLayout>

    <!--  File Usage Bar  -->
    <RelativeLayout
        android:id="@+id/view_browse_space_usage"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ProgressBar
            android:id="@+id/pb_browse_space_usage"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/all_blue_horizontal_progressbar" />

        <TextView
            android:id="@+id/tv_browse_space_usage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/placeholder"
            android:textAlignment="center"
            android:textSize="@dimen/font_size_h7" />

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
