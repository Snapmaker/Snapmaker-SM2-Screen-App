<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/view_home_laser_status"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true">

    <!-- modules status -->
    <LinearLayout
        android:id="@+id/view_home_laser_status_module_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_20"
        android:layout_marginTop="@dimen/margin_layout_10"
        android:layout_marginEnd="@dimen/margin_layout_20"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_layout_20">

            <TextView
                android:id="@+id/tv_laser_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/all_laser"
                android:textColor="@color/custom_grey_300"
                android:textSize="@dimen/font_size_h6"
                android:maxLines="2"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/iv_home_laser_status"/>

            <ImageView
                android:id="@+id/iv_home_laser_status"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/ic_home_status_normal_10x10" />

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/view_home_laser_camera"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_layout_5"
            android:layout_marginEnd="@dimen/margin_layout_20">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/iv_home_laser_status_camera"
                android:maxLines="2"
                android:text="@string/all_camera"
                android:textColor="@color/custom_grey_300"
                android:textSize="@dimen/font_size_h6" />

            <ImageView
                android:id="@+id/iv_home_laser_status_camera"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/ic_home_status_normal_10x10" />

        </RelativeLayout>

        <!--    add-on status    -->
        <include
            android:id="@+id/view_home_laser_add_on"
            layout="@layout/fragment_home_add_on_status"
            android:visibility="gone" />

    </LinearLayout>

    <!-- modules status -->
    <RelativeLayout
        android:id="@+id/view_home_laser_status_machine_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_layout_40"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/view_home_laser_status_module_status">

        <RelativeLayout
            android:id="@+id/view_widget_laser_focus"
            android:layout_width="120dp"
            android:layout_height="50dp"
            android:layout_marginStart="@dimen/margin_layout_20"
            android:layout_marginTop="@dimen/margin_layout_10"
            android:layout_marginEnd="@dimen/margin_layout_20">

            <TextView
                android:id="@+id/tv_widget_laser_focus_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_marginTop="@dimen/margin_layout_5"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/all_laser_height"
                android:textAlignment="textStart"
                android:textColor="@color/custom_grey_300"
                android:textSize="@dimen/font_size_h6" />

            <TextView
                android:id="@+id/tv_widget_laser_focus_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_widget_laser_focus_title"
                android:layout_marginTop="@dimen/margin_layout_5"
                android:textAlignment="textStart"
                android:textColor="@color/default_theme_title"
                android:textSize="@dimen/font_size_h5" />

        </RelativeLayout>

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>