<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_theme_background"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/tv_welcome_language_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="120dp"
        android:text="@string/all_hello"
        android:textAlignment="center"
        android:textColor="@color/default_theme_title"
        android:textSize="@dimen/font_size_h1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_welcome_language_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_40"
        android:layout_marginEnd="@dimen/margin_layout_40"
        android:lines="2"
        android:text="@string/welcome_language_desc"
        android:textAlignment="center"
        android:textColor="@color/default_theme_desc1"
        android:textSize="@dimen/font_size_h3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_welcome_language_title" />

    <RelativeLayout
        android:id="@+id/rl_language_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/margin_layout_20"
        android:layout_marginTop="@dimen/margin_layout_40"
        android:layout_marginEnd="@dimen/margin_layout_20"
        app:layout_constraintBottom_toTopOf="@id/btn_welcome_set_language_next"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_welcome_language_desc">

        <Button
            android:id="@+id/btn_language_english"
            style="@style/AppTheme.Button.DefaultButton"
            android:layout_width="100dp"
            android:layout_height="@dimen/height_button_45"
            android:layout_alignTop="@id/btn_language_german"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/btn_language_german"
            android:text="English" />

        <Button
            android:id="@+id/btn_language_german"
            style="@style/AppTheme.Button.DefaultButton"
            android:layout_width="100dp"
            android:layout_height="@dimen/height_button_45"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="@dimen/margin_layout_5"
            android:layout_marginTop="@dimen/margin_layout_10"
            android:layout_marginEnd="@dimen/margin_layout_5"
            android:text="Deustch"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btn_language_simplified_chinese"
            style="@style/AppTheme.Button.DefaultButton"
            android:layout_width="100dp"
            android:layout_height="@dimen/height_button_45"
            android:layout_alignTop="@id/btn_language_german"
            android:layout_alignParentEnd="true"
            android:layout_toEndOf="@id/btn_language_german"
            android:text="简体中文" />
        　　

        <Button
            android:id="@+id/btn_language_french"
            style="@style/AppTheme.Button.DefaultButton"
            android:layout_width="100dp"
            android:layout_height="@dimen/height_button_45"
            android:layout_alignTop="@id/btn_language_japanese"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/btn_language_japanese"
            android:text="français" />

        <Button
            android:id="@+id/btn_language_japanese"
            style="@style/AppTheme.Button.DefaultButton"
            android:layout_width="100dp"
            android:layout_height="@dimen/height_button_45"
            android:layout_below="@id/btn_language_german"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="@dimen/margin_layout_5"
            android:layout_marginEnd="@dimen/margin_layout_5"
            android:layout_marginTop="@dimen/margin_layout_10"
            android:text="日本語" />
        　　

        <Button
            android:id="@+id/btn_language_spanish"
            style="@style/AppTheme.Button.DefaultButton"
            android:layout_width="100dp"
            android:layout_height="@dimen/height_button_45"
            android:layout_alignTop="@id/btn_language_japanese"
            android:layout_alignParentEnd="true"
            android:layout_toEndOf="@id/btn_language_japanese"
            android:text="español" />

        <Button
            android:id="@+id/btn_language_polish"
            style="@style/AppTheme.Button.DefaultButton"
            android:layout_width="100dp"
            android:layout_height="@dimen/height_button_45"
            android:layout_below="@id/btn_language_french"
            android:layout_alignParentStart="true"
            android:layout_marginTop="@dimen/margin_layout_10"
            android:text="Polski" />

    </RelativeLayout>

    <Button
        android:id="@+id/btn_welcome_set_language_next"
        style="@style/AppTheme.Button.BlueButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_button_45"
        android:layout_marginStart="@dimen/margin_layout_40"
        android:layout_marginTop="@dimen/margin_layout_20"
        android:layout_marginEnd="@dimen/margin_layout_40"
        android:layout_marginBottom="120dp"
        android:text="@string/all_next"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rl_language_list" />

</androidx.constraintlayout.widget.ConstraintLayout>