<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_theme_background"
    android:clickable="true"
    android:focusable="true">

    <include layout="@layout/widget_top_bar" />

    <!-- calibration -->
    <RelativeLayout
        android:id="@+id/view_settings_auto_calibration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_5"
        android:layout_marginTop="@dimen/margin_layout_10"
        android:layout_marginEnd="@dimen/margin_layout_5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <Button
            android:id="@+id/view_settings_advanced_auto_calibration_background"
            style="@style/AppTheme.Button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_button_45"
            android:background="@drawable/all_list_item_btn_background"
            android:enabled="false"
            android:paddingStart="@dimen/margin_layout_10"
            android:paddingEnd="@dimen/margin_layout_10"
            android:text="@string/calibration_auto_leveling"
            android:textAlignment="textStart"
            android:textAllCaps="false"
            android:textColor="@color/default_theme_title"
            android:textSize="@dimen/font_size_h5" />

        <Button
            android:id="@+id/btn_settings_advanced_auto_calibration"
            style="@style/AppTheme.Button"
            android:layout_width="75dp"
            android:layout_height="30dp"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="7.5dp"
            android:layout_marginEnd="@dimen/margin_layout_10"
            android:background="@drawable/all_btn_switch" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/view_settings_advanced_auto_calibration_background"
            android:layout_marginStart="@dimen/margin_layout_5"
            android:layout_marginEnd="@dimen/margin_layout_5"
            android:singleLine="false"
            android:text="@string/settings_auto_calibration_desc"
            android:textColor="@color/default_theme_desc1"
            android:textSize="@dimen/font_size_h6" />

    </RelativeLayout>

    <!--  fast calibration  -->
    <RelativeLayout
        android:id="@+id/view_settings_fast_calibration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_5"
        android:layout_marginTop="@dimen/margin_layout_10"
        android:layout_marginEnd="@dimen/margin_layout_5"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/view_settings_auto_calibration">

        <Button
            android:id="@+id/view_settings_advanced_fast_calibration_background"
            style="@style/AppTheme.Button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_button_45"
            android:background="@drawable/all_list_item_btn_background"
            android:enabled="false"
            android:paddingStart="@dimen/margin_layout_10"
            android:paddingEnd="@dimen/margin_layout_10"
            android:text="@string/calibration_fast_calibration"
            android:textAlignment="textStart"
            android:textAllCaps="false"
            android:textColor="@color/default_theme_title"
            android:textSize="@dimen/font_size_h5" />

        <Button
            android:id="@+id/btn_settings_advanced_fast_calibration"
            style="@style/AppTheme.Button"
            android:layout_width="75dp"
            android:layout_height="30dp"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="7.5dp"
            android:layout_marginEnd="@dimen/margin_layout_10"
            android:background="@drawable/all_btn_switch" />

        <TextView
            android:id="@+id/tv_settings_advance_fast_calibration_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/view_settings_advanced_fast_calibration_background"
            android:layout_marginStart="@dimen/margin_layout_5"
            android:layout_marginEnd="@dimen/margin_layout_5"
            android:singleLine="false"
            android:text="@string/settings_fast_calibration_desc"
            android:textColor="@color/default_theme_desc1"
            android:textSize="@dimen/font_size_h6" />

    </RelativeLayout>

    <!--  3dp advance list  -->
    <ListView
        android:id="@+id/lv_advanced_3dp_item_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_layout_20"
        android:divider="@drawable/all_list_view_divider"
        android:dividerHeight="@dimen/margin_layout_5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/view_settings_fast_calibration" />

    <RelativeLayout
        android:id="@+id/view_settings_heated_leveling"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_5"
        android:layout_marginTop="@dimen/margin_layout_10"
        android:layout_marginEnd="@dimen/margin_layout_5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lv_advanced_3dp_item_list">

        <Button
            android:id="@+id/view_settings_advanced_heated_leveling_background"
            style="@style/AppTheme.Button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_button_45"
            android:background="@drawable/all_list_item_btn_background"
            android:enabled="false"
            android:paddingStart="@dimen/margin_layout_10"
            android:paddingEnd="@dimen/margin_layout_10"
            android:text="@string/settings_3dp_heated_leveling"
            android:textAlignment="textStart"
            android:textAllCaps="false"
            android:textColor="@color/default_theme_title"
            android:textSize="@dimen/font_size_h5" />

        <Button
            android:id="@+id/btn_settings_advanced_heated_leveling"
            style="@style/AppTheme.Button"
            android:layout_width="75dp"
            android:layout_height="30dp"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="7.5dp"
            android:layout_marginEnd="@dimen/margin_layout_10"
            android:background="@drawable/all_btn_switch" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/view_settings_advanced_heated_leveling_background"
            android:layout_marginStart="@dimen/margin_layout_5"
            android:layout_marginEnd="@dimen/margin_layout_5"
            android:singleLine="false"
            android:text="@string/settings_3dp_heated_leveling_desc"
            android:textColor="@color/default_theme_desc1"
            android:textSize="@dimen/font_size_h6" />

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>