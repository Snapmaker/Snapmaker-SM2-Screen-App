<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_theme_background">

    <include layout="@layout/widget_top_bar" />

    <RelativeLayout
        android:id="@+id/view_enclosure_control"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/margin_layout_5"
        android:layout_marginBottom="@dimen/margin_layout_5"
        android:background="@color/default_theme_primary"
        app:layout_constraintBottom_toTopOf="@id/view_enclosure_settings"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <ImageView
            android:id="@+id/iv_enclosure_cover"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:contentDescription="@string/todo"
            android:src="@drawable/pic_enclosure_cover_360x320" />

        <include
            layout="@layout/widget_enclosure_control"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/iv_enclosure_cover"
            android:layout_marginTop="@dimen/margin_layout_40" />

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/view_enclosure_settings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/default_theme_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/btn_enclosure_settings"
            style="@style/AppTheme.Button.BlueButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_button_45"
            android:layout_marginStart="@dimen/margin_layout_20"
            android:layout_marginTop="@dimen/margin_layout_10"
            android:layout_marginEnd="@dimen/margin_layout_20"
            android:layout_marginBottom="@dimen/margin_layout_10"
            android:text="@string/all_settings" />

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>