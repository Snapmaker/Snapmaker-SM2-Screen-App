<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_theme_background"
    android:clickable="true"
    android:focusable="true">

    <include layout="@layout/widget_top_bar" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/default_theme_primary"
        android:layout_marginTop="@dimen/margin_layout_10"
        android:layout_marginBottom="@dimen/margin_layout_10"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintBottom_toTopOf="@id/view_settings_indicator_mode_button" >

        <TextView
            android:id="@+id/tv_settings_indicator_mode_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_layout_40"
            android:text="@string/placeholder"
            android:textColor="@color/default_theme_desc1"
            android:textSize="@dimen/font_size_h3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:visibility="invisible"/>

        <RelativeLayout
            android:id="@+id/rl_settings_indicator_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_layout_40"
            android:layout_marginStart="@dimen/margin_layout_20"
            android:layout_marginEnd="@dimen/margin_layout_20"
            app:layout_constraintTop_toBottomOf="@id/tv_settings_indicator_mode_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <RadioGroup
                android:id="@+id/rg_settings_indicator_mode_select"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_settings_indicator_mode_crossline"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_gravity="end"
                    android:button="@null"
                    android:background="@drawable/settings_laser_indicator_mode_crossline" />

                <RadioButton
                    android:id="@+id/rb_settings_indicator_mode_laser_spot"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_marginStart="@dimen/margin_layout_20"
                    android:layout_gravity="end"
                    android:button="@null"
                    android:background="@drawable/settings_laser_indicator_mode_laser_spot" />

            </RadioGroup>

            <TextView
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:layout_below="@id/rg_settings_indicator_mode_select"
                android:layout_alignParentStart="true"
                android:layout_marginTop="@dimen/margin_layout_10"
                android:text="@string/settings_laser_40w_laser_indicator_mode_crossline"
                android:textAlignment="center"
                android:textColor="@color/custom_grey_0"
                android:textSize="@dimen/font_size_h5" />

            <TextView
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:layout_below="@id/rg_settings_indicator_mode_select"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="@dimen/margin_layout_10"
                android:text="@string/settings_laser_40w_laser_indicator_mode_laser_spot"
                android:textAlignment="center"
                android:textColor="@color/custom_grey_0"
                android:textSize="@dimen/font_size_h5" />

        </RelativeLayout>
        
        <TextView
            android:id="@+id/tv_settings_indicator_mode_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/preview_laser_40w_settings_laser_indicator_desc"
            android:textSize="@dimen/font_size_h4"
            android:textAlignment="center"
            android:textColor="@color/default_theme_desc1"
            android:layout_marginStart="@dimen/margin_layout_20"
            android:layout_marginEnd="@dimen/margin_layout_20"
            android:layout_marginTop="@dimen/margin_layout_40"
            app:layout_constraintTop_toBottomOf="@id/rl_settings_indicator_mode"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <RelativeLayout
        android:id="@+id/view_settings_indicator_mode_button"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginTop="@dimen/margin_layout_5"
        android:background="@color/default_theme_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/btn_settings_indicator_mode_save"
            style="@style/AppTheme.Button.BlueButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_button_45"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/margin_layout_20"
            android:layout_marginEnd="@dimen/margin_layout_20"
            android:text="@string/all_save" />
    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
