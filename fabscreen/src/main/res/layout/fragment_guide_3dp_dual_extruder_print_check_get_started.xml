<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_theme_background"
    android:clickable="true"
    android:focusable="true">

    <include layout="@layout/widget_top_bar_back_only" />

    <TextView
        android:id="@+id/tv_guide_3dp_dual_extruder_print_check_get_started_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_20"
        android:layout_marginTop="@dimen/margin_layout_20"
        android:layout_marginEnd="@dimen/margin_layout_20"
        android:ellipsize="end"
        android:fontFamily="@string/font_roboto_condensed_light"
        android:maxLines="2"
        android:text="@string/calibration_dual_extruder_print_check_get_started_title"
        android:textColor="@color/default_theme_title"
        android:textSize="@dimen/font_size_h2"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar" />

    <TextView
        android:id="@+id/tv_guide_3dp_dual_extruder_print_check_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_20"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="@dimen/margin_layout_20"
        android:text="@string/calibration_dual_extruder_print_check_get_started_desc"
        android:textColor="@color/custom_grey_200"
        android:textSize="@dimen/font_size_h5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_guide_3dp_dual_extruder_print_check_get_started_title" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_20"
        android:layout_marginTop="@dimen/margin_layout_32"
        android:layout_marginEnd="@dimen/margin_layout_20"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_guide_3dp_dual_extruder_print_check_desc">

        <TextView
            android:id="@+id/tv_guide_3dp_dual_extruder_print_check_content_sub_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@string/font_roboto_condensed_light"
            android:text="@string/calibration_dual_extruder_print_check_get_started_content_sub_title"
            android:textColor="@color/default_theme_title"
            android:textSize="@dimen/font_size_h3"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_guide_3dp_dual_extruder_print_check_content_steps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/calibration_dual_extruder_print_check_get_started_content_steps"
            android:textColor="@color/custom_grey_200"
            android:textSize="@dimen/font_size_h5" />

    </LinearLayout>

    <RelativeLayout
        android:id="@+id/view_guide_3dp_dual_extruder_print_check_get_started_buttons"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/btn_guide_3dp_dual_extruder_print_check_get_started"
            style="@style/AppTheme.Button.BlueButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_button_45"
            android:layout_alignParentTop="true"
            android:layout_marginStart="@dimen/margin_layout_20"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="@dimen/margin_layout_20"
            android:text="@string/all_start" />

        <Button
            android:id="@+id/btn_guide_3dp_dual_extruder_print_check_skip"
            style="@style/AppTheme.Button.SecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_button_45"
            android:layout_below="@id/btn_guide_3dp_dual_extruder_print_check_get_started"
            android:layout_marginStart="@dimen/margin_layout_20"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="@dimen/margin_layout_20"
            android:layout_marginBottom="12.5dp"
            android:text="@string/all_skip" />

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
