<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_theme_background"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <include layout="@layout/widget_top_bar_back_only" />

    <ImageView
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_marginTop="@dimen/margin_layout_40"
        android:layout_marginBottom="50dp"
        android:src="@drawable/pic_laser_10w_settings_thickness_180x180"
        tools:ignore="ContentDescription" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_20"
        android:layout_marginTop="@dimen/margin_layout_20"
        android:layout_marginEnd="@dimen/margin_layout_20"
        android:gravity="center_horizontal"
        android:text="@string/settings_laser_measure_thickness"
        android:textColor="@color/custom_grey_200"
        android:textSize="@dimen/font_size_h3"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_20"
        android:layout_marginTop="@dimen/margin_layout_10"
        android:layout_marginEnd="@dimen/margin_layout_20"
        android:gravity="center_horizontal"
        android:text="@string/settings_laser_confirm_red_dot_on_calibration_plate"
        android:textColor="@color/custom_grey_200"
        android:textSize="@dimen/font_size_h5" />

    <Button
        android:id="@+id/btn_laser_10w_calibration_measure"
        style="@style/AppTheme.Button.BlueButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_button_45"
        android:layout_marginStart="@dimen/margin_layout_40"
        android:layout_marginTop="@dimen/margin_layout_60"
        android:layout_marginEnd="@dimen/margin_layout_40"
        android:text="@string/all_measure" />
</LinearLayout>