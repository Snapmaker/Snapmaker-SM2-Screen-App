<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_theme_background"
    android:clickable="true"
    android:focusable="true">

    <include layout="@layout/widget_top_bar" />

    <TextView
        android:id="@+id/tv_experiment_bluetooth_status_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_10"
        android:layout_marginTop="@dimen/margin_layout_10"
        android:text="Bluetooth Status:"
        android:textAlignment="textStart"
        android:textColor="@color/custom_grey_200"
        android:textSize="@dimen/font_size_h4"
        app:layout_constraintStart_toEndOf="@id/tv_experiment_bluetooth_status"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar" />

    <TextView
        android:id="@+id/tv_experiment_bluetooth_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_10"
        android:layout_marginTop="@dimen/margin_layout_10"
        android:layout_marginEnd="@dimen/margin_layout_10"
        android:text="@string/placeholder"
        android:textAlignment="textStart"
        android:textColor="@color/custom_grey_200"
        android:textSize="@dimen/font_size_h4"
        app:layout_constraintEnd_toStartOf="@id/btn_experiment_bluetooth_open"
        app:layout_constraintStart_toEndOf="@id/tv_experiment_bluetooth_status_desc"
        app:layout_constraintTop_toBottomOf="@id/top_bar" />

    <TextView
        android:id="@+id/tv_experiment_bluetooth_connected_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/margin_layout_10"
        android:textAlignment="textStart"
        android:textColor="@color/custom_grey_200"
        android:textSize="@dimen/font_size_h4"
        app:layout_constraintEnd_toStartOf="@id/btn_experiment_bluetooth_open"
        app:layout_constraintStart_toStartOf="@id/tv_experiment_bluetooth_status"
        app:layout_constraintTop_toBottomOf="@id/tv_experiment_bluetooth_status" />

    <Button
        android:id="@+id/btn_experiment_bluetooth_open"
        style="@style/AppTheme.Button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_layout_10"
        android:layout_marginEnd="@dimen/margin_layout_10"
        android:background="@drawable/files_file_type_btn_background"
        android:text="Open"
        android:textAllCaps="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar" />

    <Button
        android:id="@+id/btn_experiment_bluetooth_wb"
        style="@style/AppTheme.Button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="@dimen/margin_layout_10"
        android:background="@drawable/files_file_type_btn_background"
        android:text="Auto WB"
        android:textAllCaps="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_experiment_bluetooth_open" />

    <Button
        android:id="@+id/btn_experiment_bluetooth_camera_lighting"
        style="@style/AppTheme.Button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="@dimen/margin_layout_10"
        android:background="@drawable/files_file_type_btn_background"
        android:text="Lighting"
        android:textAllCaps="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_experiment_bluetooth_wb" />


    <ImageView
        android:id="@+id/iv_experiment_bluetooth_pic"
        android:layout_width="350dp"
        android:layout_height="350dp"
        android:scaleType="fitCenter"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <RelativeLayout
        android:id="@+id/rl_experiment_bt_operation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_10"
        android:layout_marginEnd="@dimen/margin_layout_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/btn_experiment_bluetooth_request_without_flash_light"
            style="@style/AppTheme.Button.DefaultButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_button_45"
            android:layout_marginStart="@dimen/margin_layout_20"
            android:layout_marginTop="@dimen/margin_layout_10"
            android:layout_marginEnd="@dimen/margin_layout_20"
            android:text="Request Without Flashlight"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_experiment_bluetooth_request"
            style="@style/AppTheme.Button.BlueButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_button_45"
            android:layout_below="@id/btn_experiment_bluetooth_request_without_flash_light"
            android:layout_marginStart="@dimen/margin_layout_20"
            android:layout_marginTop="@dimen/margin_layout_10"
            android:layout_marginEnd="@dimen/margin_layout_20"
            android:layout_marginBottom="@dimen/margin_layout_20"
            android:text="Request"
            android:textAllCaps="false" />

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>