<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_theme_background">

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_welcome_terms"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/margin_layout_10"
        android:layout_marginTop="@dimen/margin_layout_20"
        android:layout_marginEnd="@dimen/margin_layout_10"
        android:layout_marginBottom="@dimen/margin_layout_10"
        app:cardCornerRadius="4dp"
        app:layout_constraintBottom_toTopOf="@id/btn_welcome_terms_agree"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_above="@id/view_welcome_terms_agree"
                android:padding="@dimen/margin_layout_5"
                android:scrollbarSize="2dp"
                android:scrollbarThumbVertical="@drawable/all_drawable_scrollbar_thumb_vertical"
                android:scrollbarTrackVertical="@drawable/all_drawable_scrollbar_track_vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_layout_5"
                    android:lineSpacingMultiplier="1.2"
                    android:singleLine="false"
                    android:text="@string/settings_terms_content"
                    android:textAlignment="textStart"
                    android:textColor="@color/default_theme_title"
                    android:textSize="@dimen/font_size_h6" />

            </ScrollView>

            <RelativeLayout
                android:id="@+id/view_welcome_terms_agree"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_marginTop="@dimen/margin_layout_5"
                android:layout_marginBottom="@dimen/margin_layout_5">

                <CheckBox
                    android:id="@+id/cb_welcome_terms_accept"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_layout_10"
                    android:layout_marginEnd="@dimen/margin_layout_5"
                    android:theme="@style/AppTheme.CheckBox.DefaultCheckBox" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@id/cb_welcome_terms_accept"
                    android:text="@string/welcome_terms_accept"
                    android:textAlignment="textStart"
                    android:textColor="@color/default_theme_desc1"
                    android:textSize="@dimen/font_size_h6" />

            </RelativeLayout>

        </RelativeLayout>

    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btn_welcome_terms_agree"
        style="@style/AppTheme.Button.BlueButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_button_45"
        android:layout_marginStart="@dimen/margin_layout_20"
        android:layout_marginTop="@dimen/margin_layout_10"
        android:layout_marginEnd="@dimen/margin_layout_20"
        android:layout_marginBottom="@dimen/margin_layout_10"
        android:text="@string/all_agree"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>