<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_theme_background"
    android:clickable="true"
    android:focusable="true">

    <include layout="@layout/widget_top_bar" />

    <ImageView
        android:id="@+id/iv_cnc_bit_assistant_measure_bit_instructions"
        android:layout_width="match_parent"
        android:layout_height="210dp"
        android:contentDescription="@string/placeholder"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar" />

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/vp_cnc_bit_assistant_control_panels"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/margin_layout_5"
        android:layout_marginBottom="@dimen/margin_layout_5"
        app:layout_constraintBottom_toTopOf="@id/view_cnc_bit_assistant_measure_bit_buttons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_cnc_bit_assistant_measure_bit_instructions">

        <include layout="@layout/widget_control_panel_xyz_axes_for_4axis" />

        <include layout="@layout/widget_control_panel_b_axis" />

    </androidx.viewpager.widget.ViewPager>

    <!--  bottom dot indicator for ViewPager  -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tl_cnc_bit_assistant_control_panel_indicator"
        style="@style/AppTheme.DefaultPageIndicator"
        app:layout_constraintBottom_toBottomOf="@id/vp_cnc_bit_assistant_control_panels"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- buttons -->
    <FrameLayout
        android:id="@+id/view_cnc_bit_assistant_measure_bit_buttons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/default_theme_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/btn_bit_assistant_measure_bit_set"
            style="@style/AppTheme.Button.BlueButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_button_45"
            android:layout_marginStart="@dimen/margin_layout_20"
            android:layout_marginTop="@dimen/margin_layout_10"
            android:layout_marginEnd="@dimen/margin_layout_20"
            android:layout_marginBottom="@dimen/margin_layout_10"
            android:text="@string/control_set_origin_panel_set" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
