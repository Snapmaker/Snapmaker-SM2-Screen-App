<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/widget_control_panel_b_axis"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_theme_primary">

    <co.ceryle.segmentedbutton.SegmentedButtonGroup
        android:id="@+id/sbg_control_b_axis_steps"
        style="@style/AppTheme.SegmentedButtonGroup"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_segmented_button"
        android:layout_marginStart="@dimen/margin_layout_20"
        android:layout_marginTop="@dimen/margin_layout_10"
        android:layout_marginEnd="@dimen/margin_layout_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:sbg_position="0">

        <co.ceryle.segmentedbutton.SegmentedButton
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:paddingTop="8dp"
            android:text="@string/all_0_2degree"
            android:textColor="@color/default_theme_desc1" />

        <co.ceryle.segmentedbutton.SegmentedButton
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:paddingTop="8dp"
            android:text="@string/all_1degree"
            android:textColor="@color/default_theme_desc1" />

        <co.ceryle.segmentedbutton.SegmentedButton
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:paddingTop="8dp"
            android:text="@string/all_5degree"
            android:textColor="@color/default_theme_desc1" />

    </co.ceryle.segmentedbutton.SegmentedButtonGroup>

    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/margin_layout_20"
        android:layout_marginEnd="@dimen/margin_layout_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sbg_control_b_axis_steps">

        <fabscreen.libraries.legacy.view.ActionButton
            android:id="@+id/btn_widget_b_axis_counterclockwise"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/margin_layout_20"
            app:ab_foreground="@drawable/control_btn_b_counter_clockwise" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/control_b"
                android:textAlignment="center"
                android:textColor="@color/default_theme_desc2"
                android:textSize="@dimen/font_size_h3" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/all_offset"
                android:textAlignment="center"
                android:textColor="@color/default_theme_desc2"
                android:textSize="@dimen/font_size_h6" />
        </LinearLayout>

        <fabscreen.libraries.legacy.view.ActionButton
            android:id="@+id/btn_widget_b_axis_clockwise"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/margin_layout_20"
            app:ab_foreground="@drawable/control_btn_b_clockwise" />

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
