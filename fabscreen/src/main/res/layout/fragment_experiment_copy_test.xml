<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_theme_background"
    android:clickable="true"
    android:focusable="true">

    <include layout="@layout/widget_top_bar" />

    <RelativeLayout
        android:id="@+id/view_experiment_browse_files"
        android:layout_width="match_parent"
        android:layout_height="480dp"
        android:layout_marginTop="@dimen/margin_layout_20"
        android:layout_marginStart="@dimen/margin_layout_10"
        android:layout_marginEnd="@dimen/margin_layout_10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar">
        <!-- usb files -->

        <RelativeLayout
            android:id="@+id/view_experiment_remote_files_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_browse_remote_files_empty"
                android:layout_width="60dp"
                android:layout_height="70dp"
                android:layout_centerHorizontal="true"
                android:contentDescription="@string/placeholder"
                android:src="@drawable/ic_files_empty_60x70" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/iv_browse_remote_files_empty"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="@dimen/margin_layout_10"
                android:singleLine="true"
                android:text="@string/browse_file_is_empty"
                android:textAlignment="center"
                android:textColor="@color/custom_grey_600"
                android:textSize="@dimen/font_size_h5"
                android:textStyle="bold" />

        </RelativeLayout>

        <fabscreen.libraries.legacy.view.SwipeListView
            android:id="@+id/lv_browse_remote_files"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@drawable/all_list_view_divider"
            android:dividerHeight="@dimen/height_list_divider"
            android:visibility="gone" />

    </RelativeLayout>

    <TextView
        android:id="@+id/tv_copy_test_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_layout_20"
        android:textAlignment="center"
        android:textSize="@dimen/font_size_h5"
        android:textColor="@color/custom_grey_200"
        app:layout_constraintTop_toBottomOf="@id/view_experiment_browse_files"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>