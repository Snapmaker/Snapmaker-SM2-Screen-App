<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_theme_background"
    android:clickable="true"
    android:focusable="true">

    <include layout="@layout/widget_top_bar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/margin_layout_5"
        android:layout_marginBottom="@dimen/margin_layout_5"
        android:background="@color/default_theme_primary"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/rl_calibration_dual_extruder_xy_check_result_buttons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/tv_calibration_dual_extruder_xy_check_result_x_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="@dimen/margin_layout_20"
                android:layout_marginTop="@dimen/margin_layout_20"
                android:layout_marginEnd="@dimen/margin_layout_20"
                android:text="@string/guide_3dp_dual_extruder_xy_calibration_check_result_x_sub_title"
                android:textAlignment="center"
                android:textColor="@color/custom_grey_200"
                android:textSize="@dimen/font_size_h5"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_calibration_dual_extruder_xy_check_result_x_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_calibration_dual_extruder_xy_check_result_x_title"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="@dimen/margin_layout_20"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="@dimen/margin_layout_20"
                android:text="@string/guide_3dp_dual_extruder_xy_calibration_check_result_x_desc"
                android:textAlignment="center"
                android:textColor="@color/custom_grey_200"
                android:textSize="@dimen/font_size_h6" />

            <fabscreen.libraries.legacy.view.SlidingRulerView
                android:id="@+id/srv_calibration_dual_extruder_xy_check_result_x_direction"
                android:layout_width="320dp"
                android:layout_height="134dp"
                android:layout_below="@id/tv_calibration_dual_extruder_xy_check_result_x_desc"
                android:layout_marginStart="@dimen/margin_layout_20"
                android:layout_marginTop="30dp"
                android:layout_marginEnd="@dimen/margin_layout_20"
                android:paddingStart="25dp"
                android:paddingEnd="25dp" />

        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/margin_layout_5"
            android:background="@color/default_theme_background" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/tv_calibration_dual_extruder_xy_check_result_y_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="@dimen/margin_layout_20"
                android:layout_marginTop="@dimen/margin_layout_20"
                android:layout_marginEnd="@dimen/margin_layout_20"
                android:text="@string/guide_3dp_dual_extruder_xy_calibration_check_result_y_sub_title"
                android:textAlignment="center"
                android:textColor="@color/custom_grey_200"
                android:textSize="@dimen/font_size_h5"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_calibration_dual_extruder_xy_check_result_y_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_calibration_dual_extruder_xy_check_result_y_title"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="@dimen/margin_layout_20"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="@dimen/margin_layout_20"
                android:text="@string/guide_3dp_dual_extruder_xy_calibration_check_result_y_desc"
                android:textAlignment="center"
                android:textColor="@color/custom_grey_200"
                android:textSize="@dimen/font_size_h6" />

            <fabscreen.libraries.legacy.view.SlidingRulerView
                android:id="@+id/srv_calibration_dual_extruder_xy_check_result_y_direction"
                android:layout_width="320dp"
                android:layout_height="134dp"
                android:layout_below="@id/tv_calibration_dual_extruder_xy_check_result_y_desc"
                android:layout_marginStart="@dimen/margin_layout_20"
                android:layout_marginTop="30dp"
                android:layout_marginEnd="@dimen/margin_layout_20"
                android:paddingStart="25dp"
                android:paddingEnd="25dp" />

        </RelativeLayout>

    </LinearLayout>

    <RelativeLayout
        android:id="@+id/rl_calibration_dual_extruder_xy_check_result_buttons"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/default_theme_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/btn_calibration_dual_extruder_xy_check_result_next"
            style="@style/AppTheme.Button.BlueButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_button_45"
            android:layout_centerInParent="true"
            android:layout_marginStart="@dimen/margin_layout_20"
            android:layout_marginEnd="@dimen/margin_layout_20"
            android:text="@string/all_save" />

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
