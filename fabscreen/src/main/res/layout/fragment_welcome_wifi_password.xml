<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_theme_background"
    android:clickable="true"
    android:focusable="true">

    <include layout="@layout/widget_top_bar_back_only" />

    <TextView
        android:id="@+id/tv_welcome_wifi_password_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        android:fontFamily="@string/font_roboto_condensed"
        android:text="@string/all_wifi"
        android:textAlignment="center"
        android:textColor="@color/default_theme_title"
        android:textSize="@dimen/font_size_h1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_welcome_wifi_password_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_layout_5"
        android:text="@string/placeholder"
        android:textAlignment="center"
        android:textColor="@color/default_theme_desc1"
        android:textSize="@dimen/font_size_h4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_welcome_wifi_password_title" />

    <RelativeLayout
        android:id="@+id/view_welcome_wifi_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_40"
        android:layout_marginTop="@dimen/margin_layout_40"
        android:layout_marginEnd="@dimen/margin_layout_40"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_welcome_wifi_password_subtitle">

        <EditText
            android:id="@+id/et_welcome_wifi_password_input"
            style="@style/AppTheme.EditText.DefaultEditText"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_edit_text_45"
            android:background="@drawable/all_edit_text"
            android:hint="@string/welcome_wifi_enter_password"
            android:inputType="textPassword"
            android:textAlignment="textStart"
            android:textColor="@color/default_theme_title"
            android:textSize="@dimen/font_size_h3" />

        <Button
            android:id="@+id/btn_welcome_wifi_password_visibility"
            style="@style/AppTheme.Button"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_alignEnd="@id/et_welcome_wifi_password_input"
            android:layout_marginTop="12.5dp"
            android:layout_marginEnd="@dimen/margin_layout_10"
            android:background="@drawable/ic_settings_password_hide_20x20" />

        <TextView
            android:id="@+id/tv_welcome_wifi_password_tip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/et_welcome_wifi_password_input"
            android:layout_marginTop="@dimen/margin_layout_5"
            android:text="@string/placeholder"
            android:textAlignment="center"
            android:textColor="@color/default_theme_text_warning" />

    </RelativeLayout>

    <Button
        android:id="@+id/btn_welcome_wifi_password_next"
        style="@style/AppTheme.Button.BlueButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_button_45"
        android:layout_marginStart="@dimen/margin_layout_40"
        android:layout_marginTop="@dimen/margin_layout_40"
        android:layout_marginEnd="@dimen/margin_layout_40"
        android:layout_marginBottom="@dimen/margin_layout_40"
        android:text="@string/all_connect"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/view_welcome_wifi_password" />

</androidx.constraintlayout.widget.ConstraintLayout>