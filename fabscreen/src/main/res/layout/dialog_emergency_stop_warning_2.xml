<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="@dimen/radius_8">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/default_theme_primary">

        <ImageView
            android:id="@+id/iv_dialog_emergency_stop_warning"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/margin_layout_40"
            android:contentDescription="@string/todo"
            android:src="@drawable/pic_dialog_warning_72x72" />

        <TextView
            android:id="@+id/tv_dialog_emergency_stop_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/iv_dialog_emergency_stop_warning"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/margin_layout_20"
            android:text="@string/machine_unavailable"
            android:textColor="@color/default_theme_title"
            android:textSize="@dimen/font_size_h4" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_dialog_emergency_stop_title"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="@dimen/margin_layout_20"
            android:layout_marginTop="@dimen/margin_layout_10"
            android:layout_marginEnd="@dimen/margin_layout_20"
            android:layout_marginBottom="@dimen/margin_layout_40"
            android:text="@string/emergency_stop_warning_desc2"
            android:textAlignment="center"
            android:textColor="@color/custom_grey_500"
            android:textSize="@dimen/font_size_h4" />

    </RelativeLayout>

</androidx.cardview.widget.CardView>
