<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tool="http://schemas.android.com/tools"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:background="@color/default_theme_background"
android:clickable="true"
android:focusable="true">

<include layout="@layout/widget_top_bar_back_only" />

<TextView
    android:id="@+id/tv_guide_3dp_dual_extruder_get_started_title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/margin_layout_20"
    android:layout_marginTop="@dimen/margin_layout_40"
    android:layout_marginEnd="@dimen/margin_layout_20"
    android:ellipsize="end"
    android:fontFamily="@string/font_roboto_condensed_light"
    android:maxLines="2"
    android:text="@string/guide_3dp_dual_extruder_get_started_title"
    android:textColor="@color/default_theme_title"
    android:textSize="@dimen/font_size_h2"
    android:textStyle="bold"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@+id/top_bar" />

<TextView
    android:id="@+id/tv_guide_3dp_dual_extruder_get_started_desc"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/guide_3dp_dual_extruder_get_started_content"
    android:textSize="@dimen/font_size_h5"
    android:textColor="@color/custom_grey_200"
    android:layout_marginTop="@dimen/margin_layout_5"
    android:layout_marginStart="@dimen/margin_layout_20"
    android:layout_marginEnd="@dimen/margin_layout_20"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@id/tv_guide_3dp_dual_extruder_get_started_title"
    tool:text="We will guide you through the preparations before printing:" />

<RelativeLayout
    android:id="@+id/view_guide_3dp_dual_extruder_steps"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/margin_layout_20"
    android:layout_marginEnd="@dimen/margin_layout_20"
    android:layout_marginTop="@dimen/margin_layout_32"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintTop_toBottomOf="@id/tv_guide_3dp_dual_extruder_get_started_desc">

    <TextView
        android:id="@+id/tv_guide_3dp_dual_extruder_steps_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:textAlignment="textStart"
        android:text="@string/guide_laser_calibration_intro_step_title"
        android:textColor="@color/custom_grey_200"
        android:textSize="@dimen/font_size_h3"
        android:textStyle="bold"
        tool:text="Steps" />

    <TextView
        android:id="@+id/tv_guide_3dp_dual_extruder_steps_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_guide_3dp_dual_extruder_steps_title"
        android:layout_marginTop="@dimen/margin_layout_16"
        android:text="@string/guide_3dp_dual_extruder_get_started_steps_content"
        android:textAlignment="textStart"
        android:textColor="@color/custom_grey_200"
        android:textSize="@dimen/font_size_h5" />

</RelativeLayout>

<RelativeLayout
    android:id="@+id/view_guide_3dp_dual_extruder_get_started_buttons"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent">

    <Button
        android:id="@+id/btn_guide_3dp_dual_extruder_get_started_ready"
        style="@style/AppTheme.Button.BlueButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_button_45"
        android:layout_marginStart="@dimen/margin_layout_20"
        android:layout_marginTop="@dimen/margin_layout_10"
        android:layout_marginEnd="@dimen/margin_layout_20"
        android:layout_marginBottom="@dimen/margin_layout_10"
        android:text="@string/guide_3dp_dual_extruder_get_started_im_ready" />

</RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>