<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/view_home_3dp_status"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true">

    <!-- modules status -->
    <LinearLayout
        android:id="@+id/view_home_3dp_status_module_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_20"
        android:layout_marginTop="@dimen/margin_layout_10"
        android:layout_marginEnd="@dimen/margin_layout_20"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_layout_20">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/iv_module_3dp_status"
                android:maxLines="2"
                android:text="@string/all_3d_printing"
                android:textAlignment="textStart"
                android:textColor="@color/custom_grey_300"
                android:textSize="@dimen/font_size_h6" />

            <ImageView
                android:id="@+id/iv_module_3dp_status"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/ic_home_status_normal_10x10" />

        </RelativeLayout>

        <RelativeLayout
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_layout_5"
            android:layout_marginEnd="@dimen/margin_layout_20">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/iv_home_3dp_status_heated_bed"
                android:maxLines="2"
                android:text="@string/print_heated_bed"
                android:textColor="@color/custom_grey_300"
                android:textSize="@dimen/font_size_h6" />

            <ImageView
                android:id="@+id/iv_home_3dp_status_heated_bed"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/ic_home_status_normal_10x10" />

        </RelativeLayout>

        <!--    add-on status    -->
        <include
            android:id="@+id/view_home_3dp_add_on"
            layout="@layout/fragment_home_add_on_status"
            android:visibility="gone" />

    </LinearLayout>

    <!-- modules status -->
    <RelativeLayout
        android:id="@+id/view_home_3dp_status_machine_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_layout_40"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/view_home_3dp_status_module_status">

        <RelativeLayout
            android:id="@+id/view_widget_nozzle_temp"
            android:layout_width="120dp"
            android:layout_height="50dp"
            android:layout_marginStart="@dimen/margin_layout_20"
            android:layout_marginTop="@dimen/margin_layout_10"
            android:layout_marginEnd="@dimen/margin_layout_20">

            <TextView
                android:id="@+id/tv_widget_nozzle_temp_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_marginTop="@dimen/margin_layout_5"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/print_nozzle_temp"
                android:textAlignment="textStart"
                android:textColor="@color/custom_grey_300"
                android:textSize="@dimen/font_size_h6" />

            <TextView
                android:id="@+id/tv_widget_nozzle_temp_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_widget_nozzle_temp_title"
                android:layout_marginTop="@dimen/margin_layout_5"
                android:textAlignment="textStart"
                android:textColor="@color/default_theme_title"
                android:textSize="@dimen/font_size_h5" />

        </RelativeLayout>

        <View
            android:layout_width="1px"
            android:layout_height="40dp"
            android:layout_alignBottom="@id/view_widget_nozzle_temp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/margin_layout_10"
            android:background="@color/default_theme_separator" />

        <!-- heated bed temperature -->
        <RelativeLayout
            android:id="@+id/view_widget_heated_bed_temp"
            android:layout_width="120dp"
            android:layout_height="50dp"
            android:layout_marginStart="@dimen/margin_layout_20"
            android:layout_marginTop="@dimen/margin_layout_10"
            android:layout_marginEnd="@dimen/margin_layout_20"
            android:layout_toEndOf="@id/view_widget_nozzle_temp">

            <TextView
                android:id="@+id/tv_widget_heated_bed_temp_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_layout_5"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/print_heated_bed_temp"
                android:textAlignment="textStart"
                android:textColor="@color/custom_grey_300"
                android:textSize="@dimen/font_size_h6" />

            <TextView
                android:id="@+id/tv_widget_heated_bed_temp_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_widget_heated_bed_temp_title"
                android:layout_marginTop="@dimen/margin_layout_5"
                android:textAlignment="textStart"
                android:textColor="@color/default_theme_title"
                android:textSize="@dimen/font_size_h5" />

        </RelativeLayout>

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
