<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/tv_widget_z_offset_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_layout_40"
        android:text="@string/print_z_offset"
        android:textColor="@color/default_theme_desc1"
        android:textSize="@dimen/font_size_h3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/view_widget_z_offset"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_layout_10"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_widget_z_offset_title">

        <TextView
            android:id="@+id/tv_widget_z_offset_current"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/all_0"
            android:textColor="@color/default_theme_desc1"
            android:textSize="@dimen/font_size_h1" />

        <TextView
            android:id="@+id/tv_widget_z_offset_slash"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/all_slash"
            android:textColor="@color/default_theme_desc1"
            android:textSize="@dimen/font_size_h1" />

        <TextView
            android:id="@+id/tv_widget_z_offset_target"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/all_0"
            android:textColor="@color/default_theme_title"
            android:textSize="@dimen/font_size_h1" />

        <TextView
            android:id="@+id/tv_widget_z_offset_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/all_unit_mm_with_space"
            android:textColor="@color/default_theme_title"
            android:textSize="@dimen/font_size_h2" />

    </LinearLayout>

    <co.ceryle.segmentedbutton.SegmentedButtonGroup
        android:id="@+id/sbg_widget_z_offset_steps"
        style="@style/AppTheme.SegmentedButtonGroup"
        android:layout_width="0dp"
        android:layout_height="@dimen/height_segmented_button"
        android:layout_marginStart="@dimen/margin_layout_20"
        android:layout_marginTop="@dimen/margin_layout_40"
        android:layout_marginEnd="@dimen/margin_layout_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/view_widget_z_offset"
        app:sbg_position="0">

        <Button
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingTop="8dp"
            android:text="@string/all_0_05mm"
            android:textAllCaps="false"
            android:textColor="@color/default_theme_desc1" />

        <Button
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingTop="8dp"
            android:text="@string/all_0_1mm"
            android:textAllCaps="false"
            android:textColor="@color/default_theme_desc1" />

        <Button
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingTop="8dp"
            android:text="@string/all_0_2mm"
            android:textAllCaps="false"
            android:textColor="@color/default_theme_desc1" />

    </co.ceryle.segmentedbutton.SegmentedButtonGroup>

    <RelativeLayout
        android:id="@+id/view_widget_z_offset_adjustment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sbg_widget_z_offset_steps">

        <Button
            android:id="@+id/btn_widget_z_offset_up"
            android:layout_width="@dimen/size_button_80"
            android:layout_height="@dimen/size_button_80"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/margin_layout_40"
            android:background="@drawable/control_btn_up_background" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/btn_widget_z_offset_up"
            android:layout_alignStart="@id/btn_widget_z_offset_up"
            android:layout_alignEnd="@id/btn_widget_z_offset_up"
            android:layout_marginTop="@dimen/margin_layout_5"
            android:text="@string/all_up"
            android:textAlignment="center"
            android:textAllCaps="false"
            android:textColor="@color/default_theme_desc1"
            android:textSize="@dimen/font_size_h5" />

        <Button
            android:id="@+id/btn_widget_z_offset_down"
            style="@style/AppTheme.Button"
            android:layout_width="@dimen/size_button_80"
            android:layout_height="@dimen/size_button_80"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/margin_layout_40"
            android:background="@drawable/control_btn_down_background" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/btn_widget_z_offset_down"
            android:layout_alignStart="@id/btn_widget_z_offset_down"
            android:layout_alignEnd="@id/btn_widget_z_offset_down"
            android:layout_marginTop="@dimen/margin_layout_5"
            android:text="@string/all_down"
            android:textAlignment="center"
            android:textAllCaps="false"
            android:textColor="@color/default_theme_desc1"
            android:textSize="@dimen/font_size_h5" />

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>