        <TextView
            android:id="@+id/tv_widget_coordinate_relative_y_value"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_alignBaseline="@id/tv_widget_coordinate_relative_y_label"
            android:layout_marginEnd="@dimen/margin_layout_5"
