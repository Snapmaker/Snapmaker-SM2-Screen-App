            android:id="@+id/tv_widget_coordinate_relative_b_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_widget_coordinate_relative_z_label"
            android:layout_alignStart="@id/tv_widget_coordinate_relative_label"
            android:layout_marginBottom="@dimen/margin_layout_5"
            android:text="@string/control_b"
            android:textColor="@color/default_theme_desc2"
