        <TextView
            android:id="@+id/tv_widget_coordinate_relative_b_value"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_alignBaseline="@id/tv_widget_coordinate_relative_b_label"
            android:layout_marginEnd="@dimen/margin_layout_5"
            android:layout_toEndOf="@id/tv_widget_coordinate_relative_b_label"
            android:text="@string/control_coordinate_panel_position_placeholder"
            android:textAlignment="textEnd"
