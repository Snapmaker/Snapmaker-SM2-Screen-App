            android:textColor="@color/default_theme_desc2"
            android:textSize="@dimen/font_size_h3" />

        <TextView
            android:id="@+id/tv_widget_coordinate_absolute_z_value"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_alignBaseline="@id/tv_widget_coordinate_absolute_z_label"
            android:layout_marginEnd="@dimen/margin_layout_5"
            android:layout_toEndOf="@id/tv_widget_coordinate_absolute_z_label"
            android:text="@string/control_coordinate_panel_position_placeholder"
            android:textAlignment="textEnd"
            android:textColor="@color/default_theme_title"
            android:textSize="@dimen/font_size_h3" />

        <TextView
            android:id="@+id/tv_widget_coordinate_absolute_z_mm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBaseline="@id/tv_widget_coordinate_absolute_z_label"
            android:layout_marginEnd="@dimen/margin_layout_10"
            android:layout_toEndOf="@id/tv_widget_coordinate_absolute_z_value"
            android:text="@string/control_coordinate_panel_unit"
            android:textColor="@color/default_theme_desc2"
            android:textSize="@dimen/font_size_h4" />

        <!-- B -->
        <TextView
            android:id="@+id/tv_widget_coordinate_absolute_b_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_widget_coordinate_absolute_z_label"
            android:layout_alignStart="@id/tv_widget_coordinate_absolute_label"
            android:layout_marginBottom="@dimen/margin_layout_5"
            android:text="@string/control_b"
            android:textColor="@color/default_theme_desc2"
            android:textSize="@dimen/font_size_h3" />

        <TextView
            android:id="@+id/tv_widget_coordinate_absolute_b_value"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_alignBaseline="@id/tv_widget_coordinate_absolute_b_label"
            android:layout_marginEnd="@dimen/margin_layout_5"
            android:layout_toEndOf="@id/tv_widget_coordinate_absolute_b_label"
            android:text="@string/control_coordinate_panel_position_placeholder"
            android:textAlignment="textEnd"
            android:textColor="@color/default_theme_title"
            android:textSize="@dimen/font_size_h3" />

        <TextView
            android:id="@+id/tv_widget_coordinate_absolute_b_degree"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBaseline="@id/tv_widget_coordinate_absolute_b_label"
            android:layout_marginEnd="@dimen/margin_layout_10"
            android:layout_toEndOf="@id/tv_widget_coordinate_absolute_b_value"
            android:text="@string/all_unit_degree"
            android:textColor="@color/default_theme_desc2"
            android:textSize="@dimen/font_size_h4" />

    </RelativeLayout>

    <RelativeLayout
