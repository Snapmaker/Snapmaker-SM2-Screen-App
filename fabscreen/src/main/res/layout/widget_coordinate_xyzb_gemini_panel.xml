<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_coordinate_xyzb_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/default_theme_primary">

    <RelativeLayout
        android:id="@+id/view_widget_coordinate_absolute"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_10"
        android:layout_marginEnd="@dimen/margin_layout_10">

        <TextView
            android:id="@+id/tv_widget_coordinate_absolute_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_layout_10"
            android:layout_marginTop="@dimen/margin_layout_5"
            android:text="@string/control_coordinate_panel_absolute_position"
            android:textColor="@color/default_theme_desc1"
            android:textSize="@dimen/font_size_h6" />

        <!-- X -->
        <TextView
            android:id="@+id/tv_widget_coordinate_absolute_x_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_widget_coordinate_absolute_label"
            android:layout_alignStart="@id/tv_widget_coordinate_absolute_label"
            android:layout_marginTop="@dimen/margin_layout_5"
            android:text="@string/control_x"
            android:textColor="@color/default_theme_desc2"
            android:textSize="@dimen/font_size_h3" />

        <TextView
            android:id="@+id/tv_widget_coordinate_absolute_x_value"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_alignBaseline="@id/tv_widget_coordinate_absolute_x_label"
            android:layout_marginEnd="@dimen/margin_layout_5"
            android:layout_toEndOf="@id/tv_widget_coordinate_absolute_x_label"
            android:text="@string/control_coordinate_panel_position_placeholder"
            android:textAlignment="textEnd"
            android:textColor="@color/default_theme_title"
            android:textSize="@dimen/font_size_h3" />

        <TextView
            android:id="@+id/tv_widget_coordinate_absolute_x_mm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBaseline="@id/tv_widget_coordinate_absolute_x_label"
            android:layout_toEndOf="@id/tv_widget_coordinate_absolute_x_value"
            android:text="@string/control_coordinate_panel_unit"
            android:textColor="@color/default_theme_desc2"
            android:textSize="@dimen/font_size_h4" />

        <!-- Y -->
        <TextView
            android:id="@+id/tv_widget_coordinate_absolute_y_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_widget_coordinate_absolute_x_label"
            android:layout_alignStart="@id/tv_widget_coordinate_absolute_label"
            android:text="@string/control_y"
            android:textColor="@color/default_theme_desc2"
            android:textSize="@dimen/font_size_h3" />

        <TextView
            android:id="@+id/tv_widget_coordinate_absolute_y_value"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_alignBaseline="@id/tv_widget_coordinate_absolute_y_label"
            android:layout_marginEnd="@dimen/margin_layout_5"
            android:layout_toEndOf="@id/tv_widget_coordinate_absolute_y_label"
            android:text="@string/control_coordinate_panel_position_placeholder"
            android:textAlignment="textEnd"
            android:textColor="@color/default_theme_title"
            android:textSize="@dimen/font_size_h3" />

        <TextView
            android:id="@+id/tv_widget_coordinate_absolute_y_mm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBaseline="@id/tv_widget_coordinate_absolute_y_label"
            android:layout_toEndOf="@id/tv_widget_coordinate_absolute_y_value"
            android:text="@string/control_coordinate_panel_unit"
            android:textColor="@color/default_theme_desc2"
            android:textSize="@dimen/font_size_h4" />

        <!-- Z -->
        <TextView
            android:id="@+id/tv_widget_coordinate_absolute_z_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_widget_coordinate_absolute_y_label"
            android:layout_alignStart="@id/tv_widget_coordinate_absolute_label"
