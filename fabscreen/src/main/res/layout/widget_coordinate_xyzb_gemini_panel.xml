            android:textSize="@dimen/font_size_h3" />

        <TextView
            android:id="@+id/tv_widget_coordinate_relative_y_mm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBaseline="@id/tv_widget_coordinate_relative_y_label"
            android:layout_toEndOf="@id/tv_widget_coordinate_relative_y_value"
            android:text="@string/control_coordinate_panel_unit"
            android:textColor="@color/default_theme_desc2"
            android:textSize="@dimen/font_size_h4" />

        <!-- Z -->
        <TextView
            android:id="@+id/tv_widget_coordinate_relative_z_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_widget_coordinate_relative_y_label"
            android:layout_alignStart="@id/tv_widget_coordinate_relative_label"
            android:text="@string/control_z"
            android:textColor="@color/default_theme_desc2"
            android:textSize="@dimen/font_size_h3" />

        <TextView
            android:id="@+id/tv_widget_coordinate_relative_z_value"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_alignBaseline="@id/tv_widget_coordinate_relative_z_label"
            android:layout_marginEnd="@dimen/margin_layout_5"
            android:layout_toEndOf="@id/tv_widget_coordinate_relative_z_label"
            android:text="@string/control_coordinate_panel_position_placeholder"
