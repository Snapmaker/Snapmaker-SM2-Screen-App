            android:layout_toEndOf="@id/tv_widget_coordinate_relative_x_value"
            android:text="@string/control_coordinate_panel_unit"
            android:textColor="@color/default_theme_desc2"
            android:textSize="@dimen/font_size_h4" />

        <!-- Y -->
