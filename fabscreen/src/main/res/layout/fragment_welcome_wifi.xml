<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_theme_background"
    android:clickable="true"
    android:focusable="true">

    <include layout="@layout/widget_top_bar_back_only" />

    <TextView
        android:id="@+id/tv_welcome_wifi_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        android:fontFamily="@string/font_roboto_condensed"
        android:text="@string/all_wifi"
        android:textAlignment="center"
        android:textColor="@color/default_theme_title"
        android:textSize="@dimen/font_size_h1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_welcome_wifi_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_layout_5"
        android:text="@string/welcome_wifi_subtitle"
        android:textAlignment="center"
        android:textColor="@color/default_theme_desc1"
        android:textSize="@dimen/font_size_h4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_welcome_wifi_title" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/margin_layout_20"
        android:layout_marginTop="@dimen/margin_layout_20"
        android:layout_marginEnd="@dimen/margin_layout_20"
        android:layout_marginBottom="80dp"
        app:layout_constraintBottom_toTopOf="@id/btn_welcome_wifi_skip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_welcome_wifi_subtitle">

        <ListView
            android:id="@+id/lv_welcome_wifi_access_point_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@drawable/all_list_view_divider"
            android:dividerHeight="@dimen/height_list_divider" />

    </FrameLayout>

    <RelativeLayout
        android:id="@+id/view_welcome_wifi_searching"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_20"
        android:layout_marginEnd="@dimen/margin_layout_20"
        android:layout_marginBottom="80dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/btn_welcome_wifi_skip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_welcome_wifi_subtitle">

        <ImageView
            android:id="@+id/iv_welcome_wifi_searching"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_centerHorizontal="true"
            android:contentDescription="@string/todo"
            android:src="@drawable/ic_settings_wifi_searching_72x72" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/iv_welcome_wifi_searching"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/margin_layout_5"
            android:text="@string/welcome_wifi_searching"
            android:textColor="@color/default_theme_desc1"
            android:textSize="@dimen/font_size_h4" />

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/view_welcome_wifi_no_found"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_layout_20"
        android:layout_marginEnd="@dimen/margin_layout_20"
        android:layout_marginBottom="80dp"
        app:layout_constraintBottom_toTopOf="@id/btn_welcome_wifi_skip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_welcome_wifi_subtitle">

        <ImageView
            android:id="@+id/iv_welcome_wifi_no_found"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_centerHorizontal="true"
            android:contentDescription="@string/todo"
            android:src="@drawable/ic_settings_wifi_no_found_72x72" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/iv_welcome_wifi_no_found"
            android:layout_marginTop="@dimen/margin_layout_5"
            android:text="@string/welcome_wifi_no_found"
            android:textAlignment="center"
            android:textColor="@color/default_theme_desc1"
            android:textSize="@dimen/font_size_h4" />

    </RelativeLayout>

    <Button
        android:id="@+id/btn_welcome_wifi_skip"
        style="@style/AppTheme.Button.DefaultButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_button_45"
        android:layout_marginStart="@dimen/margin_layout_20"
        android:layout_marginTop="@dimen/margin_layout_10"
        android:layout_marginEnd="@dimen/margin_layout_20"
        android:layout_marginBottom="@dimen/margin_layout_10"
        android:text="@string/all_skip"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>