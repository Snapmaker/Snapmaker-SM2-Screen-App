<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <fabscreen.libraries.legacy.view.SquareActionButton
        android:id="@+id/sab_origin_assistant_custom_bit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginTop="@dimen/margin_layout_20"
        android:layout_marginBottom="@dimen/margin_layout_10"
        app:sab_foreground="@drawable/btn_cnc_origin_assistant_custom_bit_70x70" />

    <TextView
        android:id="@+id/tv_origin_assistant_custom_bit_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/sab_origin_assistant_custom_bit"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/margin_layout_5"
        android:layout_marginBottom="@dimen/margin_layout_5"
        android:lines="1"
        android:textAlignment="center"
        android:textAllCaps="false"
        android:textColor="@color/custom_grey_500"
        android:textSize="@dimen/font_size_h6"
        android:visibility="gone" />

</RelativeLayout>
