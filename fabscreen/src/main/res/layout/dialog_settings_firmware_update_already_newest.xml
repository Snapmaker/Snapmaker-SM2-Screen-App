<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="@dimen/radius_8">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/default_theme_primary">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginStart="@dimen/margin_layout_10"
            android:layout_marginEnd="@dimen/margin_layout_10"
            android:textAlignment="center"
            android:layout_marginTop="@dimen/margin_layout_40"
            android:layout_marginBottom="@dimen/margin_layout_40"
            android:text="@string/firmware_already_newest_version"
            android:textColor="@color/default_theme_title"
            android:textSize="@dimen/font_size_h4" />

    </RelativeLayout>

</androidx.cardview.widget.CardView>
