<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="130dp"
        android:height="130dp"
        android:gravity="center">
        <shape android:shape="rectangle">
            <gradient
                android:endColor="@color/gradient_blue_end"
                android:startColor="@color/gradient_blue_start" />
            <corners android:radius="8dp" />
            <padding
                android:bottom="2dp"
                android:left="2dp"
                android:right="2dp"
                android:top="2dp" />
        </shape>
    </item>
    <item
        android:width="128dp"
        android:height="128dp"
        android:gravity="center">
        <bitmap android:src="@drawable/btn_calibration_dual_extruder_print_check_z_success_130x130" />
        <shape android:shape="rectangle">
            <solid android:color="@color/default_theme_background" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</layer-list>
